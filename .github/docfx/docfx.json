{
  "metadata": [
    {
      "src": [
        {
          "files": [
            "**/*.csproj",
			"**/**/*.csproj"
          ],
          "src": ".",
          "exclude": [
            "**/bin/**",
            "**/obj/**",
            "**/Tests/**",
            "**/Test*/**",
            "**/Examples/**"
          ]
        }
      ],
      "dest": "api",
      "includePrivateMembers": false,
      "disableDefaultFilter": false,
      "noRestore": true,
      "namespaceLayout": "flattened",
      "memberLayout": "samePage",
      "allowCompilationErrors": true
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/**.yml",
          "api/**.md",
          "api/index.md"
        ]
      },
      {
        "files": [
          "docs/**.md",
          "docs/**/toc.yml",
          "toc.yml",
          "*.md",
          "README.md"
        ],
        "src": ".",
        "dest": "."
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "output": "_site",
    "globalMetadata": {
      "_appTitle": "Interesting Algorithms",
      "_appFooter": "Copyright © 2025 - . All rights reserved.",
      "_enableSearch": true,
      "_enableNewTab": true
    },
    "globalMetadataFiles": [],
    "fileMetadataFiles": [],
    "template": [
      "default",
      "modern"
    ],
    "postProcessors": [],
    "keepFileLink": false,
    "disableGitFeatures": false,
    "disableDefaultFilter": false,
    "noLangKeyword": false,
    "sitemap": {
      "baseUrl": "https://NovoDwarf.github.io/InterestingAlgorithms/",
      "priority": 0.5,
      "changefreq": "monthly"
    },
    "markdownEngineName": "markdig"
  }
}