

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:views="using:NovoDwarf.Mathematics.App.Views"
             xmlns:localizations="using:NovoDwarf.Mathematics.App.Resources.Localizations"
             xmlns:debug1="using:NovoDwarf.Mathematics.App.Views.Debug"
             x:Class="NovoDwarf.Mathematics.App.Views.DebugPage" 
             x:DataType="views:DebugPage"
             Title="{x:Static localizations:Components_Resources.Title_Debug}">
	<ContentPage.Content>
		<ScrollView Margin="4">
			<VerticalStackLayout Padding="16" Spacing="12">
				<Border StrokeShape="RoundRectangle 12" Padding="16">
					<toolkit:Expander>
						<toolkit:Expander.Header>
							<Label>Отладка сохраненных данных</Label>
						</toolkit:Expander.Header>
						<debug1:PreferencesDebugView />
					</toolkit:Expander>
				</Border>

			</VerticalStackLayout>
		</ScrollView>
	</ContentPage.Content>
</ContentPage>