

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:common="using:NovoDwarf.Mathematics.App.ViewModels.Common"
             x:Class="NovoDwarf.Mathematics.App.Views.Common.ParameterView" x:DataType="common:ParameterViewModel">
    <ContentView.Content>
        <Border StrokeShape="RoundRectangle 12"
                Padding="16">
            
            <Grid ColumnDefinitions="1*, 2*">
                <VerticalStackLayout Grid.Column="0" Padding="16">
                    <Label Text="{Binding Name}" FontAttributes="Bold" HorizontalOptions="Start" />
                    <Label Text="{Binding Description}" FontSize="14" HorizontalOptions="Start" />
                </VerticalStackLayout>
                
                <VerticalStackLayout Grid.Column="1">
                    <Entry Text="{Binding Value}"/>
                    <Label>
                        <Label.Text>
                            <MultiBinding StringFormat="{}Минимум: {0}, Максимум: {1}">
                                <Binding Path="Min"/>
                                <Binding Path="Max"/>
                            </MultiBinding>
                        </Label.Text>
                    </Label>
                </VerticalStackLayout>
            </Grid>
        </Border>
    </ContentView.Content>
</ContentView>