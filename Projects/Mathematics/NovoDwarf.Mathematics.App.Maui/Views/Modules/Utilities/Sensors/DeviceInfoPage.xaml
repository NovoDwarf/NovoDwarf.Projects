

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:sensors="using:NovoDwarf.Mathematics.App.ViewModels.Utilities.Sensors"
             x:Class="NovoDwarf.Mathematics.App.Views.Modules.Utilities.Sensors.DeviceInfoPage" 
             x:DataType="sensors:DeviceInfoViewModel">
	<ContentPage.Content>
		<ScrollView>
			<VerticalStackLayout
				Padding="16"
				Spacing="12">

				<Label Text="Устройство" FontAttributes="Bold"/>

				<Label Text="{Binding Manufacturer}" />
				<Label Text="{Binding Model}" />
				<Label Text="{Binding DeviceType}" />

				<Label Text="Система" FontAttributes="Bold" Margin="0,12,0,0"/>

				<Label Text="{Binding Platform}" />
				<Label Text="{Binding OsVersion}" />

				<Label Text="Экран" FontAttributes="Bold" Margin="0,12,0,0"/>

				<Label Text="{Binding ScreenInfo}" />
				<Label Text="{Binding Density}" />

				<Label Text="Приложение" FontAttributes="Bold" Margin="0,12,0,0"/>

				<Label Text="{Binding AppName}" />
				<Label Text="{Binding AppVersion}" />

				<Label Text="Сеть" FontAttributes="Bold" Margin="0,12,0,0"/>

				<Label Text="{Binding NetworkAccess}" />

			</VerticalStackLayout>
		</ScrollView>
	</ContentPage.Content>
</ContentPage>