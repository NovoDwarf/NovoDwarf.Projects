<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
    xmlns:skiaSharpView="using:LiveChartsCore.SkiaSharpView"
    xmlns:sensors="using:NovoDwarf.Mathematics.App.ViewModels.Utilities.Sensors"
    xmlns:loc="using:NovoDwarf.Mathematics.App.Resources.Localizations"
    xmlns:local="using:NovoDwarf.Mathematics.App.Systems.Application.Constants"
    x:Class="NovoDwarf.Mathematics.App.Views.Modules.Utilities.Sensors.AccelerometerPage"
    x:DataType="sensors:AccelerometerViewModel"
    Title="{x:Static loc:Components_Resources.Title_Accelerometer}">
    
    <ContentPage.Content>
        <ScrollView Margin="4">
            <!--<VerticalStackLayout Padding="20" Spacing="16">
                ~1~ Header @1@
                <Border Padding="12" BackgroundColor="{DynamicResource SecondaryColor}">
                    <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                        <Label Text="Акселерометр" FontSize="18" FontAttributes="Bold"/>
                        <Label Text="{Binding Status}" 
                               FontSize="14"
                               TextColor="{Binding StatusColor}"/>
                    </HorizontalStackLayout>
                </Border>

                ~1~ Current Values @1@
                <Border Padding="16" StrokeThickness="1" Stroke="{DynamicResource Gray300}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{Binding Magnitude, StringFormat='{0:F3} g'}" 
                               FontSize="16" FontAttributes="Bold" 
                               HorizontalOptions="Center"/>
                        
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            ~1~ Axis X @1@
                            <Border Padding="8" BackgroundColor="{DynamicResource SurfaceColor}">
                                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                    <Label Text="X" FontSize="12" TextColor="Gray"/>
                                    <Label Text="{Binding X, StringFormat='{0:F3}'}" 
                                           FontSize="24" FontAttributes="Bold"
                                           TextColor="{Binding XColor}"/>
                                    <ProgressBar Progress="{Binding XNormalized}" 
                                                 ProgressColor="{Binding XColor}"
                                                 HeightRequest="4"/>
                                </VerticalStackLayout>
                            </Border>
                            
                            ~1~ Axis Y @1@
                            <Border Grid.Column="1" Padding="8" BackgroundColor="{DynamicResource SurfaceColor}">
                                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                    <Label Text="Y" FontSize="12" TextColor="Gray"/>
                                    <Label Text="{Binding Y, StringFormat='{0:F3}'}" 
                                           FontSize="24" FontAttributes="Bold"
                                           TextColor="{Binding YColor}"/>
                                    <ProgressBar Progress="{Binding YNormalized}" 
                                                 ProgressColor="{Binding YColor}"
                                                 HeightRequest="4"/>
                                </VerticalStackLayout>
                            </Border>
                            
                            ~1~ Axis Z @1@
                            <Border Grid.Column="2" Padding="8" BackgroundColor="{DynamicResource SurfaceColor}">
                                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                    <Label Text="Z" FontSize="12" TextColor="Gray"/>
                                    <Label Text="{Binding Z, StringFormat='{0:F3}'}" 
                                           FontSize="24" FontAttributes="Bold"
                                           TextColor="{Binding ZColor}"/>
                                    <ProgressBar Progress="{Binding ZNormalized}" 
                                                 ProgressColor="{Binding ZColor}"
                                                 HeightRequest="4"/>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                        
                        ~1~ G (Gravity) @1@
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,8">
                            <Border Padding="12">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Модуль вектора" FontSize="12" TextColor="Gray"/>
                                    <Label Text="{Binding Magnitude, StringFormat='{0:F3} м/с²'}" 
                                           FontSize="18" FontAttributes="Bold"/>
                                    <Label Text="{Binding MagnitudeDescription}" 
                                           FontSize="12" TextColor="Gray"/>
                                </VerticalStackLayout>
                            </Border>
                            
                            <Border Grid.Column="1" Padding="12">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Гравитация" FontSize="12" TextColor="Gray"/>
                                    ~1~
                                        <Label Text="{Binding Gravity, StringFormat='{0:F3} g'}"
                                               FontSize="18" FontAttributes="Bold" /> 
                                    @1@
                                    <Label Text="{Binding Orientation}" 
                                           FontSize="12" TextColor="Gray"/>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                ~1~ Charts @1@
                <Border Padding="12" StrokeThickness="1" Stroke="{DynamicResource Gray300}">
                    <VerticalStackLayout Spacing="16">
                        <Label Text="Динамика изменений (последние 60 с)" 
                               FontSize="16" FontAttributes="Bold"/>
                        
                        ~1~ Axis X@1@
                        <VerticalStackLayout Spacing="4">
                            <HorizontalStackLayout>
                                <Label Text="Ось X" FontSize="14"/>
                                <Label Text="{Binding XStats}" FontSize="12" TextColor="Gray"/>
                            </HorizontalStackLayout>
                            <lvc:CartesianChart
                                HeightRequest="100"
                                Series="{Binding XSeries}"
                                TooltipTextSize="10">
                                
                                <lvc:CartesianChart.YAxes>
                                    <skiaSharpView:Axis
                                        MinLimit="-2"
                                        MaxLimit="2"
                                        TextSize="10"
                                        Labeler="{x:Static local:AxisLabelers.Value}" />
                                </lvc:CartesianChart.YAxes>
                                <lvc:CartesianChart.XAxes>
                                    <skiaSharpView:Axis
                                        MinLimit="0"
                                        MaxLimit="60"
                                        TextSize="10"
                                        Labeler="{x:Static local:AxisLabelers.Time}" />
                                </lvc:CartesianChart.XAxes>
                            </lvc:CartesianChart>
                        </VerticalStackLayout>
                        
                        ~1~ Axis Y@1@
                        <VerticalStackLayout Spacing="4">
                            <HorizontalStackLayout>
                                <Label Text="Ось Y" FontSize="14"/>
                                <Label Text="{Binding YStats}" FontSize="12" TextColor="Gray"/>
                            </HorizontalStackLayout>
                            <lvc:CartesianChart
                                HeightRequest="100"
                                Series="{Binding YSeries}"
                                TooltipTextSize="10">
                                
                                <lvc:CartesianChart.YAxes>
                                    <skiaSharpView:Axis
                                        MinLimit="-2"
                                        MaxLimit="2"
                                        TextSize="10"
                                        Labeler="{x:Static local:AxisLabelers.Value}" />
                                </lvc:CartesianChart.YAxes>
                                <lvc:CartesianChart.XAxes>
                                    <skiaSharpView:Axis
                                        MinLimit="0"
                                        MaxLimit="60"
                                        TextSize="10"
                                        Labeler="{x:Static local:AxisLabelers.Time}" />
                                </lvc:CartesianChart.XAxes>
                            </lvc:CartesianChart>
                        </VerticalStackLayout>
                        
                        ~1~ Axis Z @1@
                        <VerticalStackLayout Spacing="4">
                            <HorizontalStackLayout>
                                <Label Text="Ось Z" FontSize="14"/>
                                <Label Text="{Binding ZStats}" FontSize="12" TextColor="Gray"/>
                            </HorizontalStackLayout>
                            <lvc:CartesianChart
                                HeightRequest="100"
                                Series="{Binding ZSeries}"
                                TooltipTextSize="10">
                                
                                <lvc:CartesianChart.YAxes>
                                    <skiaSharpView:Axis
                                        MinLimit="-2"
                                        MaxLimit="2"
                                        TextSize="10"
                                        Labeler="{x:Static local:AxisLabelers.Value}" />
                                </lvc:CartesianChart.YAxes>
                                <lvc:CartesianChart.XAxes>
                                    <skiaSharpView:Axis
                                        MinLimit="0"
                                        MaxLimit="60"
                                        TextSize="10"
                                        Labeler="{x:Static local:AxisLabelers.Time}" />
                                </lvc:CartesianChart.XAxes>
                            </lvc:CartesianChart>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                ~1~ Статистика и контроль @1@
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Button Text="{Binding ButtonText}" 
                            Command="{Binding ToggleCommand}"
                            BackgroundColor="{Binding ButtonColor}"/>
                    
                    <Button Grid.Column="1" 
                            Text="Сброс данных" 
                            Command="{Binding ResetCommand}"
                            BackgroundColor="{DynamicResource Gray200}"/>
                </Grid>
                
            </VerticalStackLayout>-->
        </ScrollView>
    </ContentPage.Content>
</ContentPage>

