<views:MemorablePage 
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:views="using:NovoDwarf.Mathematics.App.Core.Views"
	xmlns:organizers="using:NovoDwarf.Mathematics.App.ViewModels.Utilities.Organizers"
	xmlns:localizations="using:NovoDwarf.Mathematics.App.Resources.Localizations"
	x:Class="NovoDwarf.Mathematics.App.Views.Modules.Utilities.Organizers.ConverterPage" 
	x:DataType="organizers:ConverterViewModel"
	Title="{x:Static localizations:Components_Resources.Title_Converter}">
	
	<ContentPage.Content>
		<ScrollView>
			<VerticalStackLayout Spacing="16" Padding="16">

				<!-- Группа конвертации -->
				<Picker
					Title="Тип конвертации"
					ItemsSource="{Binding ConverterGroups}"
					SelectedItem="{Binding SelectedGroup}" />

				<!-- Подгруппа -->
				<Picker
					Title="Категория"
					ItemsSource="{Binding Categories}"
					ItemDisplayBinding="{Binding DisplayName}"
					SelectedItem="{Binding SelectedCategory}" />
            
				<!-- Ввод значения -->
				<Entry
					Placeholder="Введите значение"
					Keyboard="Numeric"
					Text="{Binding InputValue}" />
            
				<!-- Единицы -->
				<Grid ColumnDefinitions="*,*" ColumnSpacing="12">
					<Picker
						Grid.Column="0"
						Title="Из"
						ItemsSource="{Binding FromUnits}"
						ItemDisplayBinding="{Binding DisplayName}"
						SelectedItem="{Binding SelectedFromUnit}" />
                
					<Picker
						Grid.Column="1"
						Title="В"
						ItemsSource="{Binding ToUnits}"
						ItemDisplayBinding="{Binding DisplayName}"
						SelectedItem="{Binding SelectedToUnit}" />
				</Grid>
            
				<Button
					Text="Конвертировать"
					Command="{Binding ConvertCommand}" />
            
				<!-- Резуьтат -->
				<Frame Padding="12" IsVisible="{Binding HasResult}">
					<Label
						Text="{Binding ResultText}"
						FontSize="18"
						FontAttributes="Bold" />
				</Frame>
            
				<!-- Индикатор загрузки (например, валюты) -->
				<ActivityIndicator
					IsRunning="{Binding IsBusy}"
					IsVisible="{Binding IsBusy}" />
			</VerticalStackLayout>
		</ScrollView>
	</ContentPage.Content>
</views:MemorablePage>