

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:tools="using:NovoDwarf.Mathematics.App.ViewModels.Utilities.Tools"
             x:Class="NovoDwarf.Mathematics.App.Views.Modules.Utilities.Tools.SynthPage" 
             x:DataType="tools:SynthViewModel">
	<ContentPage.Content>
		<GraphicsView
			x:Name="PianoRollView"
			Drawable="{Binding PianoRollDrawable}"
			HorizontalOptions="Fill"
			StartInteraction="OnStartInteraction"
			DragInteraction="OnDragInteraction"
			EndInteraction="OnEndInteraction"/>
	</ContentPage.Content>
</ContentPage>