<drawings:DrawPageBase 
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:drawings="using:NovoDwarf.Mathematics.App.Views.Modules.Graphics.Drawings"
	xmlns:graphics="using:NovoDwarf.Mathematics.App.Views.Graphics"
	x:Class="NovoDwarf.Mathematics.App.Views.Modules.Graphics.Drawings.LineDrawPage">
	
	<drawings:DrawPageBase.Content>
		<VerticalStackLayout Spacing="10">
			<!-- Алгоритм -->
			<Label Text="Алгоритм отрисовки" FontAttributes="Bold"/>
			<Picker x:Name="AlgorithmPicker" Title="Выберите алгоритм">
				<Picker.Items>
					<x:String>Простейший пошаговый</x:String>
					<x:String>DDA</x:String>
					<x:String>Целочисленный Брезенхем</x:String>
					<x:String>Общий Брезенхем</x:String>
					<x:String>Ву</x:String>
				</Picker.Items>
			</Picker>

			<Button Text="Начать рисование" Clicked="OnDrawLineClicked"/>

			<!-- Canvas с жестами -->
			<graphics:GridCanvas x:Name="GridCanvas"
			                   HeightRequest="800"
			                   WidthRequest="800"
			                   PixelScale="30">
				<graphics:GridCanvas.GestureRecognizers>
					<PinchGestureRecognizer PinchUpdated="OnPinchUpdated"/>
					<PanGestureRecognizer PanUpdated="OnPanUpdated"/>
					<TapGestureRecognizer Tapped="OnCanvasTapped"/>
				</graphics:GridCanvas.GestureRecognizers>
			</graphics:GridCanvas>
			
		</VerticalStackLayout>
	</drawings:DrawPageBase.Content>
</drawings:DrawPageBase>