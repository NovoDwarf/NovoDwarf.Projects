<drawings:DrawPageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             xmlns:drawings="using:NovoDwarf.Mathematics.App.Views.Modules.Graphics.Drawings"
             x:Class="NovoDwarf.Mathematics.App.Views.Modules.Graphics.Drawings.TruncationDrawPage">
	<drawings:DrawPageBase.Content>
		<VerticalStackLayout Padding="12" Spacing="8">

			<Picker x:Name="AlgorithmPicker"
			        Title="Алгоритм отсечения"
			        SelectedIndexChanged="OnAlgorithmChanged">
				<Picker.Items>
					<x:String>Коэн–Сазерленд</x:String>
					<x:String>Кирус–Бэк</x:String>
					<x:String>Лян-Барский</x:String>
					<x:String>Сазерленд-Хогдман</x:String>
				</Picker.Items>
			</Picker>

			<controls:SKCanvasView x:Name="Canvas"
			                       HorizontalOptions="Center"
			                       VerticalOptions="Center"
			                       PaintSurface="OnPaintSurface"
			                       HeightRequest="800"
			                       WidthRequest="800">
				<controls:SKCanvasView.GestureRecognizers>
					<PinchGestureRecognizer PinchUpdated="OnPinchUpdated"/>
					<PanGestureRecognizer PanUpdated="OnPanUpdated"/>
				</controls:SKCanvasView.GestureRecognizers>
			</controls:SKCanvasView>

		</VerticalStackLayout>
	</drawings:DrawPageBase.Content>
</drawings:DrawPageBase>