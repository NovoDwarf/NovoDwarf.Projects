<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:settings="clr-namespace:AiForms.Settings;assembly=SettingsView"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit">

    <!-- =======================
         Сторонние компоненты
    ======================= -->
    <Style TargetType="settings:SettingsView">
        <Setter Property="CellBackgroundColor" Value="{toolkit:AppThemeResource Color.Surface.Secondary}" />
        <Setter Property="BackgroundColor" Value="{toolkit:AppThemeResource Color.Surface.Primary}" />
        <Setter Property="HeaderBackgroundColor" Value="{toolkit:AppThemeResource Color.Surface.Primary}" />
        <Setter Property="SeparatorColor" Value="{toolkit:AppThemeResource Color.Separator}" /> 
        <Setter Property="HeaderTextColor" Value="{toolkit:AppThemeResource Color.Text.Accent}" />
        <Setter Property="CellTitleColor" Value="{toolkit:AppThemeResource Color.Text.Primary}" />
        <Setter Property="CellDescriptionColor" Value="{toolkit:AppThemeResource Color.Text.Secondary}" />
        <Setter Property="CellValueTextColor" Value="{toolkit:AppThemeResource Color.Text.Secondary}" />
        <Setter Property="CellAccentColor" Value="{toolkit:AppThemeResource Color.Text.Accent}" />
        <Setter Property="SelectedColor" Value="{toolkit:AppThemeResource Color.Selection}" />
    </Style>

    <!-- =======================
         Базовые элементы
    ======================= -->
    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{toolkit:AppThemeResource Color.Text.Primary}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />

        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{toolkit:AppThemeResource Color.Text.Disabled}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Label" x:Key="Headline">
        <Setter Property="TextColor" Value="{toolkit:AppThemeResource Color.Text.Headline}" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style TargetType="Label" x:Key="SubHeadline">
        <Setter Property="TextColor" Value="{toolkit:AppThemeResource Color.Text.Headline}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style TargetType="BoxView">
        <Setter Property="BackgroundColor" Value="{toolkit:AppThemeResource Color.Control.Background}" />
    </Style>

    <Style TargetType="Border">
        <Setter Property="Stroke" Value="{toolkit:AppThemeResource Color.Control.Border}" />
        <Setter Property="StrokeShape" Value="Rectangle"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="BackgroundColor" Value="{toolkit:AppThemeResource Color.Control.Background}"/>
    </Style>

    <Style TargetType="Shadow">
        <Setter Property="Radius" Value="15" />
        <Setter Property="Opacity" Value="0.5" />
        <Setter Property="Brush" Value="{toolkit:AppThemeResource Color.Elevation.Shadow}" />
        <Setter Property="Offset" Value="10,10" />
    </Style>

    <!-- =======================
         Индикаторы и прогресс
    ======================= -->
    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{toolkit:AppThemeResource Color.Control.Accent}" />
    </Style>

    <Style TargetType="IndicatorView">
        <Setter Property="IndicatorColor" Value="{toolkit:AppThemeResource Color.Indicator.Normal}" />
        <Setter Property="SelectedIndicatorColor" Value="{toolkit:AppThemeResource Color.Indicator.Selected}" />
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="ProgressColor" Value="{toolkit:AppThemeResource Color.Indicator.Primary}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="ProgressColor" Value="{toolkit:AppThemeResource Color.Indicator.Disabled}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="RefreshView">
        <Setter Property="RefreshColor" Value="{toolkit:AppThemeResource Color.Indicator.Primary}" />
    </Style>

    <!-- =======================
         Кнопки и действия
    ======================= -->
    <Style TargetType="Button">
        <Setter Property="TextColor" Value="{toolkit:AppThemeResource Color.Button.Primary.Text}" />
        <Setter Property="BackgroundColor" Value="{toolkit:AppThemeResource Color.Button.Primary.Background}" />
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="BorderWidth" Value="0"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="MinimumHeightRequest" Value="44"/>
        <Setter Property="MinimumWidthRequest" Value="44"/>

        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{toolkit:AppThemeResource Color.Button.Disabled.Text}" />
                            <Setter Property="BackgroundColor" Value="{toolkit:AppThemeResource Color.Button.Disabled.Background}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver" />
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="ImageButton">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="BorderColor" Value="Transparent"/>
        <Setter Property="BorderWidth" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="MinimumHeightRequest" Value="44"/>
        <Setter Property="MinimumWidthRequest" Value="44"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.5" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver" />
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- =======================
         Элементы выбора
    ======================= -->
    <Style TargetType="CheckBox">
        <Setter Property="Color" Value="{toolkit:AppThemeResource Color.SelectionControl.Accent}" />
        <Setter Property="MinimumHeightRequest" Value="44"/>
        <Setter Property="MinimumWidthRequest" Value="44"/>

        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Color" Value="{toolkit:AppThemeResource Color.SelectionControl.Disabled}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="TextColor" Value="{toolkit:AppThemeResource Color.Input.Text}" />
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="MinimumHeightRequest" Value="44"/>
        <Setter Property="MinimumWidthRequest" Value="44"/>

        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{toolkit:AppThemeResource Color.Input.Text.Disabled}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{toolkit:AppThemeResource Color.Indicator.Primary}" />
        <Setter Property="ThumbColor" Value="{toolkit:AppThemeResource Color.Control.Accent}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="OnColor" Value="{toolkit:AppThemeResource Color.Indicator.Disabled}" />
                            <Setter Property="ThumbColor" Value="{toolkit:AppThemeResource Color.Control.Accent.Disabled}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="On">
                        <VisualState.Setters>
                            <Setter Property="OnColor" Value="{toolkit:AppThemeResource Color.SelectionControl.Accent}" />
                            <Setter Property="ThumbColor" Value="{toolkit:AppThemeResource Color.Control.Accent}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Off">
                        <VisualState.Setters>
                            <Setter Property="ThumbColor" Value="{toolkit:AppThemeResource Color.Control.Background.Disabled}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- =======================
         Поля ввода
    ======================= -->
    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{toolkit:AppThemeResource Color.Input.Text}" />
        <Setter Property="PlaceholderColor" Value="{toolkit:AppThemeResource Color.Input.Placeholder}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinimumHeightRequest" Value="44"/>
        <Setter Property="MinimumWidthRequest" Value="44"/>

        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{toolkit:AppThemeResource Color.Input.Text.Disabled}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Editor">
        <Setter Property="TextColor" Value="{toolkit:AppThemeResource Color.Input.Text}" />
        <Setter Property="PlaceholderColor" Value="{toolkit:AppThemeResource Color.Input.Placeholder}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinimumHeightRequest" Value="44"/>
        <Setter Property="MinimumWidthRequest" Value="44"/>

        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{toolkit:AppThemeResource Color.Input.Text.Disabled}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="SearchBar">
        <Setter Property="TextColor" Value="{toolkit:AppThemeResource Color.Input.Text}" />
        <Setter Property="PlaceholderColor" Value="{toolkit:AppThemeResource Color.Input.Placeholder}" />
        <Setter Property="CancelButtonColor" Value="{toolkit:AppThemeResource Color.Input.Placeholder}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinimumHeightRequest" Value="44"/>
        <Setter Property="MinimumWidthRequest" Value="44"/>

        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{toolkit:AppThemeResource Color.Input.Text.Disabled}" />
                            <Setter Property="PlaceholderColor" Value="{toolkit:AppThemeResource Color.Input.Text.Disabled}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="SearchHandler">
        <Setter Property="TextColor" Value="{toolkit:AppThemeResource Color.Input.Text}" />
        <Setter Property="PlaceholderColor" Value="{toolkit:AppThemeResource Color.Input.Placeholder}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />

        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{toolkit:AppThemeResource Color.Input.Text.Disabled}" />
                            <Setter Property="PlaceholderColor" Value="{toolkit:AppThemeResource Color.Input.Text.Disabled}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="TextColor" Value="{toolkit:AppThemeResource Color.Input.Text}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="MinimumHeightRequest" Value="44"/>
        <Setter Property="MinimumWidthRequest" Value="44"/>

        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{toolkit:AppThemeResource Color.Input.Text.Disabled}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="TimePicker">
        <Setter Property="TextColor" Value="{toolkit:AppThemeResource Color.Input.Text}" />
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="MinimumHeightRequest" Value="44"/>
        <Setter Property="MinimumWidthRequest" Value="44"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{toolkit:AppThemeResource Color.Input.Text.Disabled}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{toolkit:AppThemeResource Color.Input.Text}" />
        <Setter Property="TitleColor" Value="{toolkit:AppThemeResource Color.Input.Text}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinimumHeightRequest" Value="44"/>
        <Setter Property="MinimumWidthRequest" Value="44"/>

        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{toolkit:AppThemeResource Color.Input.Text.Disabled}" />
                            <Setter Property="TitleColor" Value="{toolkit:AppThemeResource Color.Input.Text.Disabled}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- =======================
         Слайдеры и контролы
    ======================= -->
    <Style TargetType="Slider">
        <Setter Property="MinimumTrackColor" Value="{toolkit:AppThemeResource Color.Indicator.Primary}" />
        <Setter Property="MaximumTrackColor" Value="{toolkit:AppThemeResource Color.Control.Background.Disabled}" />
        <Setter Property="ThumbColor" Value="{toolkit:AppThemeResource Color.Control.Accent}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="MinimumTrackColor" Value="{toolkit:AppThemeResource Color.Indicator.Disabled}" />
                            <Setter Property="MaximumTrackColor" Value="{toolkit:AppThemeResource Color.Indicator.Disabled}" />
                            <Setter Property="ThumbColor" Value="{toolkit:AppThemeResource Color.Control.Accent.Disabled}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- =======================
         Прочие элементы
    ======================= -->
    <Style TargetType="SwipeItem">
        <Setter Property="BackgroundColor" Value="{toolkit:AppThemeResource Color.Surface.Primary}" />
    </Style>

    <!-- =======================
         Навигация и страницы
    ======================= -->
    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BackgroundColor" Value="{toolkit:AppThemeResource Color.Background.Primary}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <!-- Основные цвета Shell -->
        <Setter Property="BackgroundColor" Value="{toolkit:AppThemeResource Color.Background.Primary}" />
        <Setter Property="ForegroundColor" Value="{toolkit:AppThemeResource Color.Text.Primary}" />
        <Setter Property="TitleColor" Value="{toolkit:AppThemeResource Color.Text.Primary}" />
        <Setter Property="DisabledColor" Value="{toolkit:AppThemeResource Color.Text.Disabled}" />
        <Setter Property="UnselectedColor" Value="{toolkit:AppThemeResource Color.Text.Secondary}" />

        <!-- TabBar -->
        <Setter Property="TabBarBackgroundColor" Value="{toolkit:AppThemeResource Color.Background.Primary}" />
        <Setter Property="TabBarForegroundColor" Value="{toolkit:AppThemeResource Color.Control.Accent}" />
        <Setter Property="TabBarTitleColor" Value="{toolkit:AppThemeResource Color.Control.Accent}" />
        <Setter Property="TabBarUnselectedColor" Value="{toolkit:AppThemeResource Color.Text.Secondary}" />

        <!-- Flyout (боковое меню) -->
        <Setter Property="FlyoutBackgroundColor" Value="{toolkit:AppThemeResource Color.Surface.Primary}" />
        <Setter Property="NavBarHasShadow" Value="False" />
    </Style>

    <Style TargetType="NavigationPage">
        <Setter Property="BarBackgroundColor" Value="{toolkit:AppThemeResource Color.Background.Primary}" />
        <Setter Property="BarTextColor" Value="{toolkit:AppThemeResource Color.Text.Primary}" />
        <Setter Property="IconColor" Value="{toolkit:AppThemeResource Color.Icon.Primary}" />
    </Style>

    <Style TargetType="TabbedPage">
        <Setter Property="BarBackgroundColor" Value="{toolkit:AppThemeResource Color.Background.Primary}" />
        <Setter Property="BarTextColor" Value="{toolkit:AppThemeResource Color.Control.Accent}" />
        <Setter Property="SelectedTabColor" Value="{toolkit:AppThemeResource Color.Text.Primary}" />
        <Setter Property="UnselectedTabColor" Value="{toolkit:AppThemeResource Color.Text.Secondary}" />
    </Style>

</ResourceDictionary>