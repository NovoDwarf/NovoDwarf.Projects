<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="using:Mathematics.App.Maui.UI.ViewModels"
             xmlns:distributions="clr-namespace:Mathematics.App.Maui.UI.Views.Distributions"
             xmlns:resources="using:Mathematics.Core.Resources"
             x:Class="Mathematics.App.Maui.UI.Views.Pages.DistributionsPage" 
             x:DataType="viewModels:DistributionsViewModel">
    <ContentPage.Content>
        <ScrollView Padding="4" Margin="16">
            <VerticalStackLayout Spacing="16">
                <Border>
                    <VerticalStackLayout Spacing="10">
                        <Label Text="" 
                               FontSize="24" 
                               FontAttributes="Bold" 
                               HorizontalOptions="Center"/>
                
                        <Label Text="Select a distribution to view details and parameters" 
                               FontSize="14" 
                               TextColor="Gray" 
                               HorizontalOptions="Center"/>
                
                    </VerticalStackLayout>
                </Border>
                
                <CollectionView ItemsSource="{Binding Distributions}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:DistributionPreViewModel">
                            <distributions:DistributionPreView Margin="0, 8, 0, 8" Padding="2" BindingContext="{Binding .}"/>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>