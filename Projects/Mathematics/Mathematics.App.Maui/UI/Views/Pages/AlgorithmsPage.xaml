<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:common="clr-namespace:Mathematics.App.Maui.UI.Views.Common"
             xmlns:pages="clr-namespace:Mathematics.App.Maui.UI.Views.Pages"
             xmlns:loc="clr-namespace:Mathematics.App.Maui.Resources.Localizations"
             x:Class="Mathematics.App.Maui.UI.Views.Pages.AlgorithmsPage">
    <ContentPage.Content>
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="12">
                <common:PreviewView Name="{x:Static loc:Components_Resources.TitleHome}" Description="P" Page="{x:Type pages:DistributionsPage }"/>
                <common:PreviewView Name="Distributions" Description="P" Page="{x:Type pages:CompressionsPage }"/>
                <common:PreviewView Name="Distributions" Description="P" Page="{x:Type pages:CryptographyPage }"/>
                <common:PreviewView Name="Distributions" Description="P" Page="{x:Type pages:FunctionsPage }"/>
                <common:PreviewView Name="Distributions" Description="P" Page="{x:Type pages:GraphicsPage }"/>
                <common:PreviewView Name="Distributions" Description="P" Page="{x:Type pages:RandomsPage }"/>
                <common:PreviewView Name="Distributions" Description="P" Page="{x:Type pages:SortingsPage }"/>
            </VerticalStackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>