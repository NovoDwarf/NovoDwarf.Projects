<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="using:Mathematics.App.Maui.UI.ViewModels"
             xmlns:loc="clr-namespace:LocalizationResourceManager.Maui;assembly=LocalizationResourceManager.Maui"
             xmlns:localizations="clr-namespace:Mathematics.App.Maui.Resources.Localizations"
             x:Class="Mathematics.App.Maui.UI.Views.Distributions.DistributionPreView" x:DataType="viewModels:DistributionPreViewModel">
    <ContentView.Content>
        <Border>
            <Grid ColumnDefinitions="*, Auto" Padding="16">
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="{loc:TranslateBinding Name}" FontSize="24" FontAttributes="Bold" HorizontalOptions="Start" />
                    <Label Text="{loc:TranslateBinding Description}" FontSize="14" TextColor="Gray" HorizontalOptions="Start" />
                </VerticalStackLayout>
    
                <Button Text="{x:Static localizations:Components_Resources.ButtonOpen}" Command="{Binding OpenCommand}" Grid.Column="1" VerticalOptions="Center" />
            </Grid>
        </Border>
    </ContentView.Content>
</ContentView>