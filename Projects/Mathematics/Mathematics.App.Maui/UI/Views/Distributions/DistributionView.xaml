<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="using:Mathematics.App.Maui.UI.ViewModels"
             xmlns:services="using:Mathematics.App.Maui.Services"
             xmlns:components="using:Mathematics.App.Maui.Resources.Localizations"
             xmlns:common="clr-namespace:Mathematics.App.Maui.UI.Views.Common"
             xmlns:maui="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
             xmlns:loc="clr-namespace:LocalizationResourceManager.Maui;assembly=LocalizationResourceManager.Maui"
             x:Class="Mathematics.App.Maui.UI.Views.Distributions.DistributionView" x:DataType="viewModels:DistributionViewModel">
    <ContentPage.Content>
<ScrollView>
    <VerticalStackLayout Spacing="20" Padding="16">
        <!-- Header -->
        <Border Padding="16">
            <VerticalStackLayout Spacing="8">
                <Label Text="{loc:TranslateBinding Name}" 
                       FontSize="24" 
                       FontAttributes="Bold" 
                       TextColor="White" 
                       HorizontalTextAlignment="Center"/>
                <Label Text="{loc:TranslateBinding Description}" 
                       FontSize="14" 
                       TextColor="White" 
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap"/>
            </VerticalStackLayout>
        </Border>

        <!-- Distribution Type -->
        <Border Padding="16">
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                <Label Text="Тип распределения:" FontAttributes="Bold" />
                <Label Text="{Binding Type}" Grid.Column="1"/>
                
                <Label Text="Подтип:" Grid.Row="1" FontAttributes="Bold" />
                <Label Text="{Binding SubType}" Grid.Row="1" Grid.Column="1"/>
            </Grid>
        </Border>

        <Border Padding="16">
            <VerticalStackLayout Spacing="12">
                
                <!-- Main Parameters -->
                <common:HeaderView Text="Основные параметры"/>
                
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                    <!-- Row 0 -->
                    <Label Text="{x:Static components:Components_Resources.LabelExpected}" FontAttributes="Bold"/>
                    <Label Text="{Binding Expected, StringFormat='{0:F4}'}" Grid.Column="1"/>
                    
                    <!-- Row 1 -->
                    <Label Text="{x:Static components:Components_Resources.LabelMean}" Grid.Row="1" FontAttributes="Bold"/>
                    <Label Text="{Binding Mean, StringFormat='{0:F4}'}" Grid.Row="1" Grid.Column="1"/>
                    
                    <!-- Row 2 -->
                    <Label Text="{x:Static components:Components_Resources.LabelMedian}" Grid.Row="2" FontAttributes="Bold"/>
                    <Label Text="{Binding Median, StringFormat='{0:F4}'}" Grid.Row="2" Grid.Column="1"/>
                </Grid>
                
                <!-- Меры распределения -->
                <common:HeaderView Text="Меры распределения"/>
                
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                    <!-- Row 0 -->
                    <Label Text="{x:Static components:Components_Resources.LabelMode}" FontAttributes="Bold"/>
                    <Label Text="{Binding Mode, StringFormat='{0:F4}'}" Grid.Column="1"/>
                    
                    <!-- Row 1 -->
                    <Label Text="{x:Static components:Components_Resources.LabelVariance}" Grid.Row="1" FontAttributes="Bold"/>
                    <Label Text="{Binding Variance, StringFormat='{0:F4}'}" Grid.Row="1" Grid.Column="1"/>
                    
                    <!-- Row 2 -->
                    <Label Text="{x:Static components:Components_Resources.LabelStandardDeviation}" Grid.Row="2" FontAttributes="Bold"/>
                    <Label Text="{Binding StandardDeviation, StringFormat='{0:F4}'}" Grid.Row="2" Grid.Column="1"/>
                    
                    <!-- Row 3 -->
                    <Label Text="{x:Static components:Components_Resources.LabelSkewness}" Grid.Row="3" FontAttributes="Bold"/>
                    <Label Text="{Binding Skewness, StringFormat='{0:F4}'}" Grid.Row="3" Grid.Column="1"/>
                    
                    <!-- Row 4 -->
                    <Label Text="{x:Static components:Components_Resources.LabelKurtosis}" Grid.Row="4" FontAttributes="Bold"/>
                    <Label Text="{Binding Kurtosis, StringFormat='{0:F4}'}" Grid.Row="4" Grid.Column="1"/>
                </Grid>
                
                <common:HeaderView Text="Диапазон значений"/>
                
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                    <!-- Row 0 -->
                    <Label Text="{x:Static components:Components_Resources.LabelMinimum}" FontAttributes="Bold"/>
                    <Label Text="{Binding Minimum, StringFormat='{0:F4}'}" Grid.Column="1"/>
                    
                    <!-- Row 1 -->
                    <Label Text="{x:Static components:Components_Resources.LabelMaximum}" Grid.Row="1" FontAttributes="Bold"/>
                    <Label Text="{Binding Maximum, StringFormat='{0:F4}'}" Grid.Row="1" Grid.Column="1"/>
                </Grid>
            </VerticalStackLayout>
        </Border>
        
        <!-- Parameters -->
        <Border Padding="16">
               <VerticalStackLayout Spacing="12">
                   <common:HeaderView Text="Параметры распределения"/>
                   
                      <CollectionView ItemsSource="{Binding Parameters}" VerticalOptions="Start">
                          <CollectionView.ItemsLayout>
                              <LinearItemsLayout ItemSpacing="10" Orientation="Vertical" />
                          </CollectionView.ItemsLayout>
                          <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="services:ParameterViewModel">
                                           <common:ParameterView/>
                                    </DataTemplate>
                             </CollectionView.ItemTemplate>
                      </CollectionView>
               </VerticalStackLayout>
        </Border>
        
        <!-- Parameters -->
        <Border Padding="16">
               <VerticalStackLayout Spacing="12">
                   <common:HeaderView Text="{x:Static components:Components_Resources.LabelResults}"/>
                   
                   <Grid ColumnDefinitions="*,*" ColumnSpacing="10" RowSpacing="8">
                             <Label Text="{x:Static components:Components_Resources.LabelValue}" FontAttributes="Bold"/>
                             <Label Text="{Binding Value, StringFormat='{0:F4}'}" Grid.Column="1" />
                      </Grid>
                      
                      <Button Command="{Binding DistributeCommand}" Text="{x:Static components:Components_Resources.ButtonCalculate}"/> 
               </VerticalStackLayout>
        </Border>
        
        <Border Padding="16">
            <VerticalStackLayout Spacing="12">
                <Grid ColumnDefinitions="1*, 1*" >
                
                    <!-- PDF -->
                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="Плотность вероятности" 
                               FontSize="16" 
                               FontAttributes="Bold" 
                               HorizontalOptions="Center"/>
                    
                        <maui:CartesianChart
                            HeightRequest="300"
                            ZoomMode="Both"
                            Series="{Binding PDFSeries}">
                        </maui:CartesianChart>
                    </VerticalStackLayout>
                
                    <!-- CDF -->
                    <VerticalStackLayout Grid.Column="1">
                        <Label Text="Функция распределения" 
                               FontSize="16" 
                               FontAttributes="Bold" 
                               HorizontalOptions="Center"/>
                    
                        <maui:CartesianChart
                            HeightRequest="300"
                            ZoomMode="Both"
                            Series="{Binding CDFSeries}">
                        </maui:CartesianChart>
                    </VerticalStackLayout>
                </Grid>
                
                <HorizontalStackLayout>
                    <Entry Text="{Binding Start}" />
                    <Entry Text="{Binding End}" />
                    <Entry Text="{Binding Step}" />
                </HorizontalStackLayout>
                
                <Button Command="{Binding PlotCommand}" Text="{x:Static components:Components_Resources.ButtonCalculate}"/> 
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</ScrollView>
    </ContentPage.Content>
</ContentPage>