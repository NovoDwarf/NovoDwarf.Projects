<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:common="using:Mathematics.App.Maui.UI.Views.Common"
             x:Class="Mathematics.App.Maui.UI.Views.Common.HeaderView" x:DataType="common:HeaderView">
    <VerticalStackLayout Spacing="4">
        <BoxView HeightRequest="{Binding LineThickness}"
                 BackgroundColor="{Binding LineColor}"
                 HorizontalOptions="Fill" />

        <Label Text="{Binding Text}"
               FontSize="{Binding FontSize}"
               FontAttributes="Bold"
               HorizontalOptions="Center" />

        <BoxView HeightRequest="{Binding LineThickness}"
                 BackgroundColor="{Binding LineColor}"
                 HorizontalOptions="Fill" />
    </VerticalStackLayout>
</ContentView>