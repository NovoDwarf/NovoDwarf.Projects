<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="using:Mathematics.App.Maui.Services"
             x:Class="Mathematics.App.Maui.UI.Views.Common.ParameterView" x:DataType="services:ParameterViewModel">
    <ContentView.Content>
        <Border>
            <Grid ColumnDefinitions="1*, 2*">
                <VerticalStackLayout Grid.Column="0" Padding="16">
                    <Label Text="{Binding Name}" FontAttributes="Bold" HorizontalOptions="Start" />
                    <Label Text="{Binding Description}" FontSize="14" TextColor="Gray" HorizontalOptions="Start" />
                </VerticalStackLayout>
                
                <Entry Grid.Column="1" Text="{Binding Value}"/>
            </Grid>
        </Border>
    </ContentView.Content>
</ContentView>