<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Mathematics.App.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Mathematics.App.Maui"
    xmlns:base="using:Mathematics.App.Maui.Base"
    xmlns:pages="clr-namespace:Mathematics.App.Maui.UI.Views.Pages"
    xmlns:localizations="using:Mathematics.App.Maui.Resources.Localizations"
    Title="Math Organizer" x:DataType="base:ShellViewModel">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="Main" />
    
    <ShellContent
        Title="Algorithms"
        ContentTemplate="{DataTemplate pages:AlgorithmsPage}"
        Route="Algorithms" />
    
    <ShellContent 
        Title="Settings"
        ContentTemplate="{DataTemplate pages:SettingsPage}"
        Route="Settings"/>
    
    <ShellContent 
        Title="About"
        ContentTemplate="{DataTemplate pages:AboutPage}"
        Route="About"/>
    
    <Shell.FlyoutFooter>
        <VerticalStackLayout>
            <Label Text="APP TIT" />
            <HorizontalStackLayout>
                <Label Text="Version: 1.0.0" />
                <Label Text="{Binding Date}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Shell.FlyoutFooter>
</Shell>
