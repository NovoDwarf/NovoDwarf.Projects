<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             x:Class="Mathematics.App.Maui.UI.Views.Graphics.FractalPage">
	<ContentPage.Content>
		<Grid>
			<controls:SKCanvasView x:Name="CanvasView"
			                   PaintSurface="OnCanvasViewPaintSurface"
			                   EnableTouchEvents="True" />
			
			<StackLayout Orientation="Horizontal"
			             HorizontalOptions="Center"
			             VerticalOptions="End"
			             Padding="10">
				<Button Text="Koch Curve" Clicked="OnKochCurveClicked"/>
				<Button Text="Tree" Clicked="OnTreeClicked"/>
			</StackLayout>
		</Grid>
	</ContentPage.Content>
</ContentPage>