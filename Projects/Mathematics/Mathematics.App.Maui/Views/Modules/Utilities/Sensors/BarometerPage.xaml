<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
    xmlns:vm="clr-namespace:Mathematics.App.Maui.UI.ViewModels.Utilities"
    xmlns:loc="clr-namespace:Mathematics.App.Maui.Resources.Localizations"
    x:Class="Mathematics.App.Maui.UI.Views.Utilities.BarometerPage"
    x:DataType="vm:BarometerViewModel"
    Title="{x:Static loc:Components_Resources.Title_Barometer}">

    <VerticalStackLayout Padding="24" Spacing="16">

        <!-- Values -->
        <Label
            Text="{Binding Pressure, StringFormat='{}{0} кПа'}"
            FontSize="42"
            HorizontalOptions="Center"/>

        <Label
            Text="{Binding Altitude, StringFormat='Высота: {0} м'}"
            FontSize="18"
            HorizontalOptions="Center"/>

        <Label
            Text="{Binding Trend}"
            FontSize="16"
            HorizontalOptions="Center"/>

        <!-- Chart -->
        <lvc:CartesianChart HeightRequest="160" Series="{Binding PressureSeries}" />

        <!-- Controls -->
        <HorizontalStackLayout HorizontalOptions="Center" Spacing="16">
            <Button Text="{x:Static loc:Components_Resources.Button_Start}" Command="{Binding ToggleCommand}" />
        </HorizontalStackLayout>

    </VerticalStackLayout>
</ContentPage>

