<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Mathematics.App.Maui.UI.ViewModels.Utilities"
             xmlns:loc="clr-namespace:Mathematics.App.Maui.Resources.Localizations"
             x:Class="Mathematics.App.Maui.UI.Views.Utilities.SpeedometerPage"
             x:DataType="vm:SpeedometerViewModel"
             Title="{x:Static loc:Components_Resources.Title_Speedometer}">
    <ContentPage.Content>
        <VerticalStackLayout
            Padding="32"
            Spacing="24"
            HorizontalOptions="Center"
            VerticalOptions="Center">

            <Label Text="Текущая скорость"
                   FontSize="18"
                   Opacity="0.7"/>

            <Label Text="{Binding Speed, StringFormat='{0:F1} км/ч'}"
                   FontSize="56"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>

            <ProgressBar
                Progress="{Binding SpeedPercent}"
                WidthRequest="300"
                HeightRequest="12"/>

            <HorizontalStackLayout Spacing="16">
                <Button Text="{x:Static loc:Components_Resources.Button_Start}"
                        Command="{Binding StartCommand}"
                        IsEnabled="{Binding CanStart}"/>

                <Button Text="{x:Static loc:Components_Resources.Button_Stop}"
                        Command="{Binding StopCommand}"
                        IsEnabled="{Binding IsRunning}"/>
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ContentPage.Content>
</ContentPage>
