<?xml version="1.0" encoding="utf-8"?>

<views:MemorablePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:utilities="clr-namespace:Mathematics.App.Maui.UI.ViewModels.Utilities"
             xmlns:loc="clr-namespace:Mathematics.App.Maui.Resources.Localizations"
             xmlns:views="clr-namespace:Mathematics.App.Core.Views"
             x:Class="Mathematics.App.Maui.UI.Views.Utilities.Organizers.ConverterPage" 
             x:DataType="utilities:ConverterViewModel"
             Title="{x:Static loc:Components_Resources.Title_Converter}">
	
	<ContentPage.Content>
		<ScrollView>
			<VerticalStackLayout Spacing="16" Padding="16">

				<!-- Группа конвертации -->
				<Picker
					Title="Тип конвертации"
					ItemsSource="{Binding ConverterGroups}"
					SelectedItem="{Binding SelectedGroup}" />

				<!-- Подгруппа -->
				<Picker
					Title="Категория"
					ItemsSource="{Binding Categories}"
					ItemDisplayBinding="{Binding DisplayName}"
					SelectedItem="{Binding SelectedCategory}" />
            
				<!-- Ввод значения -->
				<Entry
					Placeholder="Введите значение"
					Keyboard="Numeric"
					Text="{Binding InputValue}" />
            
				<!-- Единицы -->
				<Grid ColumnDefinitions="*,*" ColumnSpacing="12">
					<Picker
						Grid.Column="0"
						Title="Из"
						ItemsSource="{Binding FromUnits}"
						ItemDisplayBinding="{Binding DisplayName}"
						SelectedItem="{Binding SelectedFromUnit}" />
                
					<Picker
						Grid.Column="1"
						Title="В"
						ItemsSource="{Binding ToUnits}"
						ItemDisplayBinding="{Binding DisplayName}"
						SelectedItem="{Binding SelectedToUnit}" />
				</Grid>
            
				<Button
					Text="Конвертировать"
					Command="{Binding ConvertCommand}" />
            
				<!-- Резуьтат -->
				<Frame Padding="12" IsVisible="{Binding HasResult}">
					<Label
						Text="{Binding ResultText}"
						FontSize="18"
						FontAttributes="Bold" />
				</Frame>
            
				<!-- Индикатор загрузки (например, валюты) -->
				<ActivityIndicator
					IsRunning="{Binding IsBusy}"
					IsVisible="{Binding IsBusy}" />
			</VerticalStackLayout>
		</ScrollView>
	</ContentPage.Content>
</views:MemorablePage>