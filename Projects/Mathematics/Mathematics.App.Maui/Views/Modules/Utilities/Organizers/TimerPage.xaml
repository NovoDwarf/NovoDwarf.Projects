<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Mathematics.App.Maui.UI.ViewModels.Utilities"
             xmlns:loc="clr-namespace:Mathematics.App.Maui.Resources.Localizations"
             x:Class="Mathematics.App.Maui.UI.Views.Utilities.TimerPage"
             x:DataType="vm:TimerViewModel"
             Title="{x:Static loc:Components_Resources.Title_Timer}">
    
    <ContentPage.Content>
        <VerticalStackLayout
            Padding="32"
            Spacing="24"
            HorizontalOptions="Center"
            VerticalOptions="Center">

            <!-- Основное время -->
            <Label
                Text="{Binding TimeDisplay}"
                FontSize="56"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <!-- Ввод времени -->
            <Frame
                Padding="16"
                CornerRadius="16"
                HasShadow="True">
                <HorizontalStackLayout Spacing="12">
                    <Entry
                        Placeholder="ЧЧ"
                        WidthRequest="70"
                        HorizontalTextAlignment="Center"
                        Keyboard="Numeric"
                        MaxLength="2"
                        Text="{Binding InputHours, Mode=TwoWay}" />

                    <Label Text=":" VerticalTextAlignment="Center" />

                    <Entry
                        Placeholder="ММ"
                        WidthRequest="70"
                        HorizontalTextAlignment="Center"
                        Keyboard="Numeric"
                        MaxLength="2"
                        Text="{Binding InputMinutes, Mode=TwoWay}" />

                    <Label Text=":" VerticalTextAlignment="Center" />

                    <Entry
                        Placeholder="СС"
                        WidthRequest="70"
                        HorizontalTextAlignment="Center"
                        Keyboard="Numeric"
                        MaxLength="2"
                        Text="{Binding InputSeconds, Mode=TwoWay}" />
                </HorizontalStackLayout>
            </Frame>

            <!-- Кнопки -->
            <HorizontalStackLayout Spacing="16" HorizontalOptions="Center">
                <Button
                    Text="{x:Static loc:Components_Resources.Button_Start}"
                    Command="{Binding StartCommand}"
                    IsEnabled="{Binding CanStart}" />

                <Button
                    Text="{x:Static loc:Components_Resources.Button_Stop}"
                    Command="{Binding StopCommand}"
                    IsEnabled="{Binding IsRunning}" />

                <Button
                    Text="{x:Static loc:Components_Resources.Button_Reset}"
                    Command="{Binding ResetCommand}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ContentPage.Content>
</ContentPage>
