<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Mathematics.App.Maui.UI.ViewModels.Utilities"
             xmlns:loc="clr-namespace:Mathematics.App.Maui.Resources.Localizations"
             x:Class="Mathematics.App.Maui.UI.Views.Utilities.CalculatorPage"
             x:DataType="vm:CalculatorViewModel"
             Title="{x:Static loc:Components_Resources.Title_Calculator}">

    <ContentPage.Content>
        <VerticalStackLayout Padding="10" Spacing="10">

            <!-- Output -->
            <Label Text="{Binding Expression}" FontSize="36" HorizontalOptions="End" />
            <Label Text="{Binding Result}" FontSize="48" HorizontalOptions="End" />

            <!-- Rounding Switch -->
            <HorizontalStackLayout Spacing="10">
                <Label Text="Rounding:" VerticalOptions="Center" TextColor="White"/>
                <Picker SelectedItem="{Binding Rounding}" TextColor="Black">
                    <Picker.Items>
                        <x:String>Нет</x:String>
                        <x:String>Вверх</x:String>
                        <x:String>Вниз</x:String>
                        <x:String>К ближайшему</x:String>
                    </Picker.Items>
                </Picker>
            </HorizontalStackLayout>

            <!-- Buttons -->
            <ScrollView>
                <Grid RowSpacing="5" ColumnSpacing="5">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="60"/> <!-- Функции -->
                        <RowDefinition Height="60"/> <!-- 7 8 9 / ( ) -->
                        <RowDefinition Height="60"/> <!-- 4 5 6 * ) -->
                        <RowDefinition Height="60"/> <!-- 1 2 3 - ^ -->
                        <RowDefinition Height="60"/> <!-- 0 . C + = -->
                        <RowDefinition Height="60"/> <!-- Константы и Ans -->
                        <RowDefinition Height="60"/> <!-- Доп функции -->
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>

                    <!-- Functions -->
                    <Button Text="sin" Grid.Row="0" Grid.Column="0" BackgroundColor="#FF9500" TextColor="White" Command="{Binding AppendCommand}" CommandParameter="sin("/>
                    <Button Text="cos" Grid.Row="0" Grid.Column="1" BackgroundColor="#FF9500" TextColor="White" Command="{Binding AppendCommand}" CommandParameter="cos("/>
                    <Button Text="tan" Grid.Row="0" Grid.Column="2" BackgroundColor="#FF9500" TextColor="White" Command="{Binding AppendCommand}" CommandParameter="tan("/>
                    <Button Text="√" Grid.Row="0" Grid.Column="3" BackgroundColor="#FF9500" TextColor="White" Command="{Binding AppendCommand}" CommandParameter="sqrt("/>
                    <Button Text="DEL" Grid.Row="0" Grid.Column="4" BackgroundColor="#FF9500" TextColor="White" Command="{Binding DeleteLastCommand}"/>

                    <!-- Base and Commons -->
                    <Button Text="7" Grid.Row="1" Grid.Column="0" BackgroundColor="#D4D4D2" Command="{Binding AppendCommand}" CommandParameter="7"/>
                    <Button Text="8" Grid.Row="1" Grid.Column="1" BackgroundColor="#D4D4D2" Command="{Binding AppendCommand}" CommandParameter="8"/>
                    <Button Text="9" Grid.Row="1" Grid.Column="2" BackgroundColor="#D4D4D2" Command="{Binding AppendCommand}" CommandParameter="9"/>
                    <Button Text="/" Grid.Row="1" Grid.Column="3" BackgroundColor="#505050" TextColor="White" Command="{Binding AppendCommand}" CommandParameter="/"/>
                    <Button Text="(" Grid.Row="1" Grid.Column="4" BackgroundColor="#505050" TextColor="White" Command="{Binding AppendCommand}" CommandParameter="("/>

                    <Button Text="4" Grid.Row="2" Grid.Column="0" BackgroundColor="#D4D4D2" Command="{Binding AppendCommand}" CommandParameter="4"/>
                    <Button Text="5" Grid.Row="2" Grid.Column="1" BackgroundColor="#D4D4D2" Command="{Binding AppendCommand}" CommandParameter="5"/>
                    <Button Text="6" Grid.Row="2" Grid.Column="2" BackgroundColor="#D4D4D2" Command="{Binding AppendCommand}" CommandParameter="6"/>
                    <Button Text="*" Grid.Row="2" Grid.Column="3" BackgroundColor="#505050" TextColor="White" Command="{Binding AppendCommand}" CommandParameter="*"/>
                    <Button Text=")" Grid.Row="2" Grid.Column="4" BackgroundColor="#505050" TextColor="White" Command="{Binding AppendCommand}" CommandParameter=")"/>

                    <Button Text="1" Grid.Row="3" Grid.Column="0" BackgroundColor="#D4D4D2" Command="{Binding AppendCommand}" CommandParameter="1"/>
                    <Button Text="2" Grid.Row="3" Grid.Column="1" BackgroundColor="#D4D4D2" Command="{Binding AppendCommand}" CommandParameter="2"/>
                    <Button Text="3" Grid.Row="3" Grid.Column="2" BackgroundColor="#D4D4D2" Command="{Binding AppendCommand}" CommandParameter="3"/>
                    <Button Text="-" Grid.Row="3" Grid.Column="3" BackgroundColor="#505050" TextColor="White" Command="{Binding AppendCommand}" CommandParameter="-"/>
                    <Button Text="^" Grid.Row="3" Grid.Column="4" BackgroundColor="#505050" TextColor="White" Command="{Binding AppendCommand}" CommandParameter="^"/>

                    <Button Text="0" Grid.Row="4" Grid.Column="0" BackgroundColor="#D4D4D2" Command="{Binding AppendCommand}" CommandParameter="0"/>
                    <Button Text="." Grid.Row="4" Grid.Column="1" BackgroundColor="#D4D4D2" Command="{Binding AppendCommand}" CommandParameter="."/>
                    <Button Text="C" Grid.Row="4" Grid.Column="2" BackgroundColor="#505050" TextColor="White" Command="{Binding ClearCommand}"/>
                    <Button Text="+" Grid.Row="4" Grid.Column="3" BackgroundColor="#505050" TextColor="White" Command="{Binding AppendCommand}" CommandParameter="+"/>
                    <Button Text="=" Grid.Row="4" Grid.Column="4" BackgroundColor="#FF9500" TextColor="White" Command="{Binding CalculateCommand}"/>

                    <!-- Constants -->
                    <Button Text="π" Grid.Row="5" Grid.Column="0" BackgroundColor="#1E90FF" TextColor="White" Command="{Binding AppendCommand}" CommandParameter="π"/>
                    <Button Text="e" Grid.Row="5" Grid.Column="1" BackgroundColor="#1E90FF" TextColor="White" Command="{Binding AppendCommand}" CommandParameter="e"/>
                    <Button Text="log" Grid.Row="5" Grid.Column="2" BackgroundColor="#1E90FF" TextColor="White" Command="{Binding AppendCommand}" CommandParameter="log("/>
                    <Button Text="ln" Grid.Row="5" Grid.Column="3" BackgroundColor="#1E90FF" TextColor="White" Command="{Binding AppendCommand}" CommandParameter="ln("/>
                    <Button Text="Ans" Grid.Row="5" Grid.Column="4" BackgroundColor="#1E90FF" TextColor="White" Command="{Binding AppendCommand}" CommandParameter="{Binding Result}"/>

                    <!-- Others -->
                    <Button Text="asin" Grid.Row="6" Grid.Column="0" BackgroundColor="#FF9500" TextColor="White" Command="{Binding AppendCommand}" CommandParameter="asin("/>
                    <Button Text="acos" Grid.Row="6" Grid.Column="1" BackgroundColor="#FF9500" TextColor="White" Command="{Binding AppendCommand}" CommandParameter="acos("/>
                    <Button Text="atan" Grid.Row="6" Grid.Column="2" BackgroundColor="#FF9500" TextColor="White" Command="{Binding AppendCommand}" CommandParameter="atan("/>
                    <Button Text="Exp" Grid.Row="6" Grid.Column="3" BackgroundColor="#FF9500" TextColor="White" Command="{Binding AppendCommand}" CommandParameter="Exp("/>
                    <Button Text="1/x" Grid.Row="6" Grid.Column="4" BackgroundColor="#FF9500" TextColor="White" Command="{Binding AppendCommand}" CommandParameter="1/("/>

                </Grid>
            </ScrollView>

            <!-- История вычислений -->
            <CollectionView ItemsSource="{Binding History}" SelectionMode="None" HeightRequest="120">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Label Text="{Binding}" FontSize="20" TextColor="White"/>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ContentPage.Content>
</ContentPage>
