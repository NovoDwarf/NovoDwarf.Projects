<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:utilities="clr-namespace:Mathematics.App.Maui.UI.ViewModels.Utilities"
             x:Class="Mathematics.App.Maui.UI.Views.Utilities.SynthPage" x:DataType="utilities:SynthViewModel">
	<ContentPage.Content>
		<GraphicsView
			x:Name="PianoRollView"
			Drawable="{Binding PianoRollDrawable}"
			HorizontalOptions="Fill"
			VerticalOptions="FillAndExpand"
			StartInteraction="OnStartInteraction"
			DragInteraction="OnDragInteraction"
			EndInteraction="OnEndInteraction"/>
	</ContentPage.Content>
</ContentPage>