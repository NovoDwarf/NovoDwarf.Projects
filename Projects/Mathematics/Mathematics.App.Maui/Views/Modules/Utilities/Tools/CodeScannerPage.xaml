<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
             xmlns:utilities="using:Mathematics.App.Maui.UI.ViewModels.Utilities"
             x:Class="Mathematics.App.Maui.UI.Views.Utilities.CodeScannerPage" x:DataType="utilities:CodeScannerViewModel">
    <ContentPage.Content>
	    <Grid>
		    <zxing:CameraBarcodeReaderView x:Name="ScannerView"
		                                   BarcodesDetected="{Binding BarcodeDetectedCommand}"
		                                   IsDetecting="{Binding IsDetecting}"
		                                   VerticalOptions="FillAndExpand"
		                                   HorizontalOptions="FillAndExpand"/>

		    <StackLayout VerticalOptions="End" BackgroundColor="#80000000" Padding="10">
			    <Label Text="Результат:" TextColor="White"/>
			    <Label Text="{Binding ResultText}" TextColor="White" FontAttributes="Bold"/>
			    <Button Command="{Binding ToggleScanningCommand}"/>
		    </StackLayout>
	    </Grid>
    </ContentPage.Content>
</ContentPage>