<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:utilities="clr-namespace:Mathematics.App.Maui.UI.ViewModels.Utilities"
             xmlns:entities="clr-namespace:Mathematics.App.Maui.Models.Entities"
             x:Class="Mathematics.App.Maui.UI.Views.Utilities.CashCalculatorPage" x:DataType="utilities:CashCalculatorViewModel">
    <ContentPage.Content>
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="16">

                <Label Text="Калькулятор наличности"
                       FontSize="28"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"/>

                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="20">
                    
                    <Frame Grid.Column="0" Padding="12" CornerRadius="12" HasShadow="True">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Монеты"
                                   FontSize="20"
                                   FontAttributes="Bold"/>

                            <CollectionView ItemsSource="{Binding Coins}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="entities:CashItem">
                                        <Grid ColumnDefinitions="*,Auto"
                                              Padding="4">
                                            <Label Text="{Binding Denomination, StringFormat='{0} ₽'}"/>
                                            <Entry Grid.Column="1"
                                                   WidthRequest="60"
                                                   Keyboard="Numeric"
                                                   HorizontalTextAlignment="Center"
                                                   Text="{Binding Count, Mode=TwoWay}"/>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                            <BoxView HeightRequest="1" BackgroundColor="Gray"/>

                            <Label Text="{Binding CoinsTotal, StringFormat='Итого: {0:F2} ₽'}"
                                   FontSize="18"
                                   FontAttributes="Bold"/>
                        </VerticalStackLayout>
                    </Frame>
                    
                    <Frame Grid.Column="1" Padding="12" CornerRadius="12">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Купюры"
                                   FontSize="20"
                                   FontAttributes="Bold"/>

                            <CollectionView ItemsSource="{Binding Bills}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="entities:CashItem">
                                        <Grid ColumnDefinitions="*,Auto"
                                              Padding="4">
                                            <Label Text="{Binding Denomination, StringFormat='{0} ₽'}"/>
                                            <Entry Grid.Column="1"
                                                   WidthRequest="60"
                                                   Keyboard="Numeric"
                                                   HorizontalTextAlignment="Center"
                                                   Text="{Binding Count, Mode=TwoWay}"/>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                            <BoxView HeightRequest="1" BackgroundColor="Gray"/>

                            <Label Text="{Binding BillsTotal, StringFormat='Итого: {0:F2} ₽'}"
                                   FontSize="18"
                                   FontAttributes="Bold"/>
                        </VerticalStackLayout>
                    </Frame>

                </Grid>

                <Frame Padding="16" CornerRadius="16" BackgroundColor="#EEEEEE">
                    <Label Text="{Binding GrandTotal, StringFormat='Общий итог: {0:F2} ₽'}"
                           FontSize="24"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"/>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>