<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:Mathematics.App.Maui.Resources.Localizations"
             x:Class="Mathematics.App.Maui.UI.Views.Pages.Algorithms.CryptographyPage">
    <ContentPage.Content>
	    <ScrollView Margin="4">
		    <VerticalStackLayout Padding="16" Spacing="12">
			    <Border StrokeShape="RoundRectangle 12" Padding="16">
				    <VerticalStackLayout Spacing="10">
					    <Label Text="{x:Static loc:Components_Resources.Title_Modules}" 
					           FontSize="24" 
					           FontAttributes="Bold" 
					           HorizontalOptions="Center"/>
                
					    <Label Text="{x:Static loc:Components_Resources.Desc_Modules}" 
					           FontSize="14" 
					           HorizontalOptions="Center"/>
				    </VerticalStackLayout>
			    </Border>
			    
			    
		    </VerticalStackLayout>
	    </ScrollView>
    </ContentPage.Content>
</ContentPage>