<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Mathematics.App.Maui.UI.Views.Common.HeaderView" x:Name="Header">
    <VerticalStackLayout Spacing="4">
        <BoxView HeightRequest="{Binding LineThickness, Source={x:Reference Header}}"
                 BackgroundColor="{Binding LineColor, Source={x:Reference Header}}"
                 HorizontalOptions="Fill" />

        <Label Text="{Binding Text, Source={x:Reference Header}}"
               FontSize="{Binding FontSize, Source={x:Reference Header}}"
               FontAttributes="Bold"
               HorizontalOptions="Center" />

        <BoxView HeightRequest="{Binding LineThickness, Source={x:Reference Header}}"
                 BackgroundColor="{Binding LineColor, Source={x:Reference Header}}"
                 HorizontalOptions="Fill" />
    </VerticalStackLayout>
</ContentView>