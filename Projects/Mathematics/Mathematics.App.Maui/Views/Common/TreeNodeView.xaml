<ContentView
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:vm="clr-namespace:Mathematics.App.Maui.UI.Views.Common"
	xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
	x:Class="Mathematics.App.Maui.UI.Views.Common.TreeNodeView"
	x:DataType="vm:TreeNodeViewModel">
	
    <Grid>
        <!-- Group -->
        <toolkit:Expander IsVisible="{Binding IsGroup}">
            
            <toolkit:Expander.Header>
                <HorizontalStackLayout Spacing="6" Padding="8,6">
                    
                    <Label Text="{Binding Title}" FontAttributes="Bold" />
                    <Label Text="{Binding Description}"
                           IsVisible="{Binding HasDescription}"
                           Opacity="0.75"
                           FontSize="13" />
                </HorizontalStackLayout>
            </toolkit:Expander.Header>

            <VerticalStackLayout Padding="12,4">
                <CollectionView ItemsSource="{Binding Children}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:TreeNodeViewModel">
                            <vm:TreeNodeView />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

        </toolkit:Expander>

        <!-- List -->
        <HorizontalStackLayout IsVisible="{Binding IsLeaf}" Padding="12,6">

            <HorizontalStackLayout.GestureRecognizers>
                <TapGestureRecognizer
                    Command="{Binding TapCommand}"
                    CommandParameter="{Binding .}" />
            </HorizontalStackLayout.GestureRecognizers>

            <Grid ColumnDefinitions="Auto, *">
                <Label Grid.Column="0"
                    Text="{Binding Title}"
                    FontSize="14" />

                <Label Grid.Column="1"
                    Text="{Binding Description}"
                    IsVisible="{Binding HasDescription}"
                    FontSize="14"
                    Opacity="0.8" HorizontalOptions="End" />
            </Grid>
        </HorizontalStackLayout>
    </Grid>
</ContentView>