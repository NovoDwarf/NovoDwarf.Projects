<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:Mathematics.App.Maui.Resources.Localizations"
             xmlns:pages="using:Mathematics.App.Maui.UI.ViewModels.Pages"
             x:Class="Mathematics.App.Views.MainPage" 
             x:DataType="pages:MainViewModel"
             Title="{x:Static loc:Components_Resources.Title_Home}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="24">

                <Label Text="Недавние активности" FontSize="20" FontAttributes="Bold"/>
            
                <Border HeightRequest="160">
                    <CollectionView ItemsSource="{Binding RecentActivities}"
                                    ItemsLayout="HorizontalList"
                                    HeightRequest="150"
                                    HorizontalScrollBarVisibility="Never">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="pages:ActivityItem">
                                <Border
                                       Padding="8"
                                       Margin="4"
                                    
                                       WidthRequest="120"
                                       HeightRequest="140">
                                    <VerticalStackLayout>
                                        <VerticalStackLayout.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding OpenCommand}"/>
                                        </VerticalStackLayout.GestureRecognizers>
                                    
                                        <Label Text="{Binding Title}"
                                               FontSize="16"
                                               LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding Subtitle}"
                                               FontSize="12"
                                               TextColor="Gray"/>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>

                <Label Text="Популярные активности" FontSize="20" FontAttributes="Bold"/>
            
                <Border HeightRequest="160">
                    <CollectionView ItemsSource="{Binding RecentActivities}"
                                    ItemsLayout="HorizontalList"
                                    HeightRequest="150"
                                    HorizontalScrollBarVisibility="Never">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="pages:ActivityItem">
                                <Border
                                       Padding="8"
                                       Margin="4"
                                       WidthRequest="120"
                                       HeightRequest="140">
                                    <VerticalStackLayout>
                                        <VerticalStackLayout.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding OpenCommand}"/>
                                        </VerticalStackLayout.GestureRecognizers>
                                    
                                        <Label Text="{Binding Title}"
                                               FontSize="16"
                                               LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding Subtitle}"
                                               FontSize="12"
                                               TextColor="Gray"/>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
</ContentPage>
