<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:Mathematics.App.Maui.UI.Views.Pages"
             xmlns:loc="clr-namespace:Mathematics.App.Maui.Resources.Localizations"
             x:Class="Mathematics.App.Maui.UI.Views.Pages.DebugPage" x:DataType="pages:DebugPage">
	<ContentPage.Content>
		<VerticalStackLayout Padding="10" Spacing="10">

			<Button Text="{x:Static loc:Components_Resources.Button_Refresh}" Clicked="OnRefreshClicked"/>

			<CollectionView x:Name="PreferencesList" 
			                ItemsSource="{Binding PreferencesEntries}">
				<CollectionView.ItemTemplate>
					<DataTemplate>
						<HorizontalStackLayout Padding="5">
							<Label Text="{Binding Key}" FontAttributes="Bold" WidthRequest="150"/>
							<Label Text="{Binding Value}" />
						</HorizontalStackLayout>
					</DataTemplate>
				</CollectionView.ItemTemplate>
			</CollectionView>

		</VerticalStackLayout>
	</ContentPage.Content>
</ContentPage>