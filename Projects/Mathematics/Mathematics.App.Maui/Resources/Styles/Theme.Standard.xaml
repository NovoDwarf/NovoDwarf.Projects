<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit">

    <!-- === Общие цвета === -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="Gray50">#F9FAFB</Color>
    <Color x:Key="Gray100">#F3F4F6</Color>
    <Color x:Key="Gray200">#E5E7EB</Color>
    <Color x:Key="Gray300">#D1D5DB</Color>
    <Color x:Key="Gray400">#9CA3AF</Color>
    <Color x:Key="Gray500">#6B7280</Color>
    <Color x:Key="Gray900">#111827</Color>
    <Color x:Key="GrayDark600">#374151</Color>
    <Color x:Key="GrayDark700">#4B5563</Color>
    <Color x:Key="GrayDark800">#1F2937</Color>
    <Color x:Key="Blue500">#3B82F6</Color>
    <Color x:Key="ShadowLight">#00000033</Color>
    <Color x:Key="ShadowDark">#00000080</Color>

    <!-- === AppThemeColor === -->
    <toolkit:AppThemeColor x:Key="Color.Surface.Primary" Light="{StaticResource White}" Dark="{StaticResource Black}"/>
    <toolkit:AppThemeColor x:Key="Color.Surface.Secondary" Light="{StaticResource Gray100}" Dark="{StaticResource GrayDark600}"/>
    <toolkit:AppThemeColor x:Key="Color.Surface.Disabled" Light="{StaticResource Gray200}" Dark="{StaticResource GrayDark700}"/>

    <toolkit:AppThemeColor x:Key="Color.Background.Primary" Light="{StaticResource Gray50}" Dark="{StaticResource Gray900}"/>
    <toolkit:AppThemeColor x:Key="Color.Page.Background" Light="{StaticResource Gray50}" Dark="{StaticResource Gray900}"/>
    <toolkit:AppThemeColor x:Key="Color.Shell.Background" Light="{StaticResource White}" Dark="{StaticResource GrayDark800}"/>

    <!-- Текст -->
    <toolkit:AppThemeColor x:Key="Color.Text.Primary" Light="{StaticResource Gray900}" Dark="{StaticResource Gray50}"/>
    <toolkit:AppThemeColor x:Key="Color.Text.Secondary" Light="{StaticResource Gray500}" Dark="{StaticResource Gray300}"/>
    <toolkit:AppThemeColor x:Key="Color.Text.Tertiary" Light="{StaticResource Gray400}" Dark="{StaticResource Gray400}"/>
    <toolkit:AppThemeColor x:Key="Color.Text.Accent" Light="{StaticResource Blue500}" Dark="{StaticResource Blue500}"/>
    <toolkit:AppThemeColor x:Key="Color.Text.Disabled" Light="{StaticResource Gray300}" Dark="{StaticResource Gray500}"/>
    <toolkit:AppThemeColor x:Key="Color.Text.Headline" Light="{StaticResource Gray900}" Dark="{StaticResource Gray50}"/>

    <toolkit:AppThemeColor x:Key="Color.Icon.Primary" Light="{StaticResource Gray900}" Dark="{StaticResource Gray50}"/>
    <toolkit:AppThemeColor x:Key="Color.Shell.Foreground" Light="{StaticResource Gray900}" Dark="{StaticResource Gray50}"/>
    <toolkit:AppThemeColor x:Key="Color.Shell.Foreground.Disabled" Light="{StaticResource Gray400}" Dark="{StaticResource Gray500}"/>
    <toolkit:AppThemeColor x:Key="Color.Shell.Foreground.Unselected" Light="{StaticResource Gray500}" Dark="{StaticResource Gray400}"/>

    <!-- Разделители / выделения -->
    <toolkit:AppThemeColor x:Key="Color.Separator" Light="{StaticResource Gray200}" Dark="{StaticResource GrayDark700}"/>
    <toolkit:AppThemeColor x:Key="Color.Selection" Light="{StaticResource Blue500}" Dark="{StaticResource Blue500}"/>

    <!-- Контролы -->
    <toolkit:AppThemeColor x:Key="Color.Control.Background" Light="{StaticResource White}" Dark="{StaticResource GrayDark600}"/>
    <toolkit:AppThemeColor x:Key="Color.Control.Background.Disabled" Light="{StaticResource Gray200}" Dark="{StaticResource GrayDark700}"/>
    <toolkit:AppThemeColor x:Key="Color.Control.Border" Light="{StaticResource Gray300}" Dark="{StaticResource Gray500}"/>

    <toolkit:AppThemeColor x:Key="Color.Control.Text" Light="{StaticResource Gray900}" Dark="{StaticResource Gray50}"/>
    <toolkit:AppThemeColor x:Key="Color.Control.Text.Disabled" Light="{StaticResource Gray400}" Dark="{StaticResource Gray500}"/>
    <toolkit:AppThemeColor x:Key="Color.Control.Placeholder" Light="{StaticResource Gray400}" Dark="{StaticResource Gray400}"/>

    <toolkit:AppThemeColor x:Key="Color.Control.Accent" Light="{StaticResource Blue500}" Dark="{StaticResource Blue500}"/>
    <toolkit:AppThemeColor x:Key="Color.Control.Accent.Disabled" Light="{StaticResource Gray300}" Dark="{StaticResource Gray500}"/>

    <!-- Индикаторы / прогресс -->
    <toolkit:AppThemeColor x:Key="Color.Indicator.Normal" Light="{StaticResource Gray300}" Dark="{StaticResource Gray500}"/>
    <toolkit:AppThemeColor x:Key="Color.Indicator.Selected" Light="{StaticResource Blue500}" Dark="{StaticResource Blue500}"/>
    <toolkit:AppThemeColor x:Key="Color.Indicator.Primary" Light="{StaticResource Blue500}" Dark="{StaticResource Blue500}"/>
    <toolkit:AppThemeColor x:Key="Color.Indicator.Disabled" Light="{StaticResource Gray200}" Dark="{StaticResource GrayDark700}"/>

    <!-- Кнопки -->
    <toolkit:AppThemeColor x:Key="Color.Button.Primary.Background" Light="{StaticResource Blue500}" Dark="{StaticResource Blue500}"/>
    <toolkit:AppThemeColor x:Key="Color.Button.Primary.Text" Light="{StaticResource White}" Dark="{StaticResource Gray50}"/>
    <toolkit:AppThemeColor x:Key="Color.Button.Disabled.Background" Light="{StaticResource Gray200}" Dark="{StaticResource GrayDark700}"/>
    <toolkit:AppThemeColor x:Key="Color.Button.Disabled.Text" Light="{StaticResource Gray400}" Dark="{StaticResource Gray500}"/>

    <!-- Selection controls -->
    <toolkit:AppThemeColor x:Key="Color.SelectionControl.Accent" Light="{StaticResource Blue500}" Dark="{StaticResource Blue500}"/>
    <toolkit:AppThemeColor x:Key="Color.SelectionControl.Disabled" Light="{StaticResource Gray300}" Dark="{StaticResource GrayDark700}"/>

    <!-- Поля ввода -->
    <toolkit:AppThemeColor x:Key="Color.Input.Text" Light="{StaticResource Gray900}" Dark="{StaticResource Gray50}"/>
    <toolkit:AppThemeColor x:Key="Color.Input.Text.Disabled" Light="{StaticResource Gray400}" Dark="{StaticResource Gray500}"/>
    <toolkit:AppThemeColor x:Key="Color.Input.Placeholder" Light="{StaticResource Gray400}" Dark="{StaticResource Gray400}"/>

    <!-- Elevation / Тени -->
    <toolkit:AppThemeColor x:Key="Color.Elevation.Shadow" Light="{StaticResource ShadowLight}" Dark="{StaticResource ShadowDark}"/>
</ResourceDictionary>