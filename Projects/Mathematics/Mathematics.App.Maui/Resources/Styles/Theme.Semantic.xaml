<ResourceDictionary
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit">

     <!-- =======================
          Основные поверхности
     ======================= -->
     <toolkit:AppThemeColor x:Key="Color.Surface.Primary" />           <!-- Основная поверхность приложений, контейнеры -->
     <toolkit:AppThemeColor x:Key="Color.Surface.Secondary" />         <!-- Второстепенная поверхность, карты, карточки -->
     <toolkit:AppThemeColor x:Key="Color.Surface.Disabled" />          <!-- Заблокированные элементы UI -->

     <toolkit:AppThemeColor x:Key="Color.Background.Primary" />        <!-- Фон страниц -->
     <toolkit:AppThemeColor x:Key="Color.Page.Background" />           <!-- Фон Page, можно переиспользовать с Color.Background.Primary -->
     <toolkit:AppThemeColor x:Key="Color.Shell.Background" />          <!-- Фон Shell/NavBar/TabBar -->

     <!-- =======================
          Текст
     ======================= -->
     <toolkit:AppThemeColor x:Key="Color.Text.Primary" />              <!-- Основной текст -->
     <toolkit:AppThemeColor x:Key="Color.Text.Secondary" />            <!-- Второстепенный текст, подсказки -->
     <toolkit:AppThemeColor x:Key="Color.Text.Tertiary" />             <!-- Третичный текст, метки -->
     <toolkit:AppThemeColor x:Key="Color.Text.Accent" />               <!-- Акцентный текст -->
     <toolkit:AppThemeColor x:Key="Color.Text.Disabled" />             <!-- Заблокированный текст -->
     <toolkit:AppThemeColor x:Key="Color.Text.Headline" />             <!-- Заголовки -->

     <toolkit:AppThemeColor x:Key="Color.Icon.Primary" />              <!-- Иконки на светлом фоне -->
     <toolkit:AppThemeColor x:Key="Color.Shell.Foreground" />          <!-- Цвет текста и иконок Shell -->
     <toolkit:AppThemeColor x:Key="Color.Shell.Foreground.Disabled" />
     <toolkit:AppThemeColor x:Key="Color.Shell.Foreground.Unselected" />

     <!-- =======================
          Разделители / выделения
     ======================= -->
     <toolkit:AppThemeColor x:Key="Color.Separator" />                 <!-- Разделительные линии -->
     <toolkit:AppThemeColor x:Key="Color.Selection" />                 <!-- Выделение элементов списка -->

     <!-- =======================
          Контролы
     ======================= -->
     <toolkit:AppThemeColor x:Key="Color.Control.Background" />        <!-- Фон кнопок/полей ввода -->
     <toolkit:AppThemeColor x:Key="Color.Control.Background.Disabled" />
     <toolkit:AppThemeColor x:Key="Color.Control.Border" />            <!-- Граница кнопок, полей ввода -->

     <toolkit:AppThemeColor x:Key="Color.Control.Text" />              <!-- Текст кнопок, Entry, Label по умолчанию -->
     <toolkit:AppThemeColor x:Key="Color.Control.Text.Disabled" />     <!-- Заблокированный текст -->
     <toolkit:AppThemeColor x:Key="Color.Control.Placeholder" />       <!-- Placeholder для Entry/Editor -->

     <toolkit:AppThemeColor x:Key="Color.Control.Accent" />            <!-- Акцент для выбора, CheckBox, RadioButton -->
     <toolkit:AppThemeColor x:Key="Color.Control.Accent.Disabled" />   <!-- Заблокированный акцент -->

     <!-- =======================
          Индикаторы / прогресс
     ======================= -->
     <toolkit:AppThemeColor x:Key="Color.Indicator.Normal" />          <!-- Например, IndicatorView обычный -->
     <toolkit:AppThemeColor x:Key="Color.Indicator.Selected" />        <!-- IndicatorView выбранный -->
     <toolkit:AppThemeColor x:Key="Color.Indicator.Primary" />         <!-- ProgressBar, Slider, On Switch -->
     <toolkit:AppThemeColor x:Key="Color.Indicator.Disabled" />        <!-- Disabled состояния -->

     <!-- =======================
          Кнопки
     ======================= -->
     <toolkit:AppThemeColor x:Key="Color.Button.Primary.Background" />
     <toolkit:AppThemeColor x:Key="Color.Button.Primary.Text" />

     <toolkit:AppThemeColor x:Key="Color.Button.Disabled.Background" />
     <toolkit:AppThemeColor x:Key="Color.Button.Disabled.Text" />

     <!-- =======================
          Selection controls
     ======================= -->
     <toolkit:AppThemeColor x:Key="Color.SelectionControl.Accent" />   <!-- CheckBox, RadioButton On -->
     <toolkit:AppThemeColor x:Key="Color.SelectionControl.Disabled" /> <!-- Disabled CheckBox, RadioButton -->

     <!-- =======================
          Поля ввода
     ======================= -->
     <toolkit:AppThemeColor x:Key="Color.Input.Text" />                <!-- Entry/Editor текст -->
     <toolkit:AppThemeColor x:Key="Color.Input.Text.Disabled" />
     <toolkit:AppThemeColor x:Key="Color.Input.Placeholder" />        <!-- Placeholder -->

     <!-- =======================
          Elevation / Тени
     ======================= -->
     <toolkit:AppThemeColor x:Key="Color.Elevation.Shadow" />          <!-- Тени, DropShadow -->

</ResourceDictionary>