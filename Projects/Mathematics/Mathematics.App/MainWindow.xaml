<Window x:Class="Mathematics.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Mathematics.App"
        xmlns:viewModels="clr-namespace:Mathematics.App.ViewModels"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
   <Window.DataContext>
       <viewModels:MainWindowViewModel/>
   </Window.DataContext>
    
    <Grid RowDefinitions="Auto,Auto">
        <StackPanel Grid.Row="0">
            <Slider ToolTip="Scale" Value="{Binding Scale}" Minimum="0" Maximum="1" TickFrequency="0.001"/>
            <Slider ToolTip="Octaves" Value="{Binding Octaves}" Minimum="0" Maximum="10" TickFrequency="1"/>
            <Slider ToolTip="Persistence" Value="{Binding Persistence}" Minimum="0" Maximum="1" TickFrequency="0.001"/>
            <Slider ToolTip="Lacunarity" Value="{Binding Lacunarity}" Minimum="0" Maximum="10" TickFrequency="0.001"/>
            
            <Button Click="PreviewButton_OnClick">Click</Button>
            
            <Image MinHeight="1024" MinWidth="1024" Source="{Binding PreviewImage}"/>
        </StackPanel>
    </Grid>
</Window>
