<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SmartHome.Maui.ViewModels"
             xmlns:models="clr-namespace:SmartHome.Maui.Models"
             x:Class="SmartHome.Maui.Pages.ScenesPage"
             x:DataType="vm:ScenesViewModel"
             Title="⚡ Сценарии">

    <Grid RowDefinitions="*,Auto">

        <RefreshView Grid.Row="0"
                     Command="{Binding RefreshCommand}"
                     IsRefreshing="{Binding IsRefreshing}">
            <ScrollView>
                <VerticalStackLayout Spacing="8" Padding="8">

                    <!-- Automations section -->
                    <Label Text="Автоматизации"
                           FontSize="18"
                           FontAttributes="Bold"
                           Margin="0,8,0,4"/>

                    <CollectionView ItemsSource="{Binding Automations}"
                                    EmptyView="Нет автоматизаций"
                                    HeightRequest="300">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:AutomationState">
                                <Frame Margin="0,2" Padding="12" CornerRadius="10">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0">
                                            <Label Text="{Binding DisplayName}" FontSize="15" FontAttributes="Bold"/>
                                            <Label Text="{Binding IsEnabled, StringFormat='Статус: {0}'}"
                                                   FontSize="12" TextColor="Gray"/>
                                        </VerticalStackLayout>
                                        <Button Grid.Column="1"
                                                Text="▶ Запуск"
                                                Clicked="OnTriggerClicked"
                                                CommandParameter="{Binding}"
                                                FontSize="12" Padding="8,4" CornerRadius="6"
                                                BackgroundColor="#4CAF50" TextColor="White"/>
                                        <Button Grid.Column="2"
                                                Clicked="OnToggleAutomationClicked"
                                                CommandParameter="{Binding}"
                                                FontSize="12" Padding="8,4" CornerRadius="6"
                                                BackgroundColor="{Binding IsEnabled, Converter={x:StaticResource BoolToColorConverter}}"
                                                TextColor="White">
                                            <Button.Text>
                                                <Binding Path="IsEnabled" Converter="{x:StaticResource BoolToOnOffConverter}"/>
                                            </Button.Text>
                                        </Button>
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Scripts section -->
                    <Label Text="Скрипты"
                           FontSize="18"
                           FontAttributes="Bold"
                           Margin="0,16,0,4"/>

                    <CollectionView ItemsSource="{Binding Scripts}"
                                    EmptyView="Нет скриптов"
                                    HeightRequest="300">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:ScriptState">
                                <Frame Margin="0,2" Padding="12" CornerRadius="10">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0">
                                            <Label Text="{Binding DisplayName}" FontSize="15" FontAttributes="Bold"/>
                                            <Label Text="{Binding IsRunning, StringFormat='Запущен: {0}'}"
                                                   FontSize="12" TextColor="Gray"/>
                                        </VerticalStackLayout>
                                        <Button Grid.Column="1"
                                                Text="▶ Запустить"
                                                Clicked="OnRunScriptClicked"
                                                CommandParameter="{Binding}"
                                                FontSize="12" Padding="8,4" CornerRadius="6"
                                                BackgroundColor="#2196F3" TextColor="White"/>
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <Label Grid.Row="1"
               Text="{Binding StatusMessage}"
               TextColor="Red"
               Margin="8,4"
               IsVisible="{Binding StatusMessage, Converter={x:StaticResource StringNotEmptyConverter}}"/>

    </Grid>

</ContentPage>
