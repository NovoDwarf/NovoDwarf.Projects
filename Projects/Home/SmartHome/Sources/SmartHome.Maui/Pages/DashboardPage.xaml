<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SmartHome.Maui.ViewModels"
             x:Class="SmartHome.Maui.Pages.DashboardPage"
             x:DataType="vm:DashboardViewModel"
             Title="SmartHome Health">

    <ContentPage.Resources>
        <Style x:Key="CardFrame" TargetType="Frame">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F5F5F5, Dark=#2C2C2E}"/>
            <Setter Property="HasShadow" Value="False"/>
        </Style>
        <Style x:Key="MetricLabel" TargetType="Label">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#666, Dark=#999}"/>
        </Style>
        <Style x:Key="MetricValue" TargetType="Label">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontAttributes" Value="Bold"/>
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <!-- Header -->
            <Label Text="🏃 Здоровье сегодня"
                   FontSize="22" FontAttributes="Bold"
                   Margin="0,8,0,4"/>

            <!-- Loading indicator -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center"/>

            <!-- Metrics grid -->
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12">

                <!-- Steps -->
                <Frame Grid.Row="0" Grid.Column="0" Style="{StaticResource CardFrame}">
                    <VerticalStackLayout>
                        <Label Text="👟 Шаги" Style="{StaticResource MetricLabel}"/>
                        <Label Style="{StaticResource MetricValue}">
                            <Label.Text>
                                <MultiBinding StringFormat="{}{0:N0}">
                                    <Binding Path="Steps" TargetNullValue="—"/>
                                </MultiBinding>
                            </Label.Text>
                        </Label>
                    </VerticalStackLayout>
                </Frame>

                <!-- Heart rate -->
                <Frame Grid.Row="0" Grid.Column="1" Style="{StaticResource CardFrame}">
                    <VerticalStackLayout>
                        <Label Text="❤️ Пульс" Style="{StaticResource MetricLabel}"/>
                        <Label Style="{StaticResource MetricValue}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding HeartRate, StringFormat='{0:F0}', TargetNullValue='—'}"/>
                                    <Span Text=" bpm" FontSize="14"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </VerticalStackLayout>
                </Frame>

                <!-- Sleep -->
                <Frame Grid.Row="1" Grid.Column="0" Style="{StaticResource CardFrame}">
                    <VerticalStackLayout>
                        <Label Text="😴 Сон" Style="{StaticResource MetricLabel}"/>
                        <Label Style="{StaticResource MetricValue}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding SleepHours, StringFormat='{0:F1}', TargetNullValue='—'}"/>
                                    <Span Text=" ч" FontSize="14"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </VerticalStackLayout>
                </Frame>

                <!-- Calories -->
                <Frame Grid.Row="1" Grid.Column="1" Style="{StaticResource CardFrame}">
                    <VerticalStackLayout>
                        <Label Text="🔥 Калории" Style="{StaticResource MetricLabel}"/>
                        <Label Style="{StaticResource MetricValue}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding ActiveCalories, StringFormat='{0:F0}', TargetNullValue='—'}"/>
                                    <Span Text=" ккал" FontSize="14"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </VerticalStackLayout>
                </Frame>

                <!-- Resting HR + SpO2 -->
                <Frame Grid.Row="2" Grid.Column="0" Style="{StaticResource CardFrame}">
                    <VerticalStackLayout>
                        <Label Text="💤 Пульс в покое" Style="{StaticResource MetricLabel}"/>
                        <Label Style="{StaticResource MetricValue}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding RestingHeartRate, StringFormat='{0:F0}', TargetNullValue='—'}"/>
                                    <Span Text=" bpm" FontSize="14"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </VerticalStackLayout>
                </Frame>

                <Frame Grid.Row="2" Grid.Column="1" Style="{StaticResource CardFrame}">
                    <VerticalStackLayout>
                        <Label Text="🩸 SpO₂" Style="{StaticResource MetricLabel}"/>
                        <Label Style="{StaticResource MetricValue}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding SpO2, StringFormat='{0:F1}', TargetNullValue='—'}"/>
                                    <Span Text=" %" FontSize="14"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </VerticalStackLayout>
                </Frame>

                <!-- Weight -->
                <Frame Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource CardFrame}">
                    <VerticalStackLayout>
                        <Label Text="⚖️ Вес" Style="{StaticResource MetricLabel}"/>
                        <Label Style="{StaticResource MetricValue}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding Weight, StringFormat='{0:F1}', TargetNullValue='—'}"/>
                                    <Span Text=" кг" FontSize="14"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </VerticalStackLayout>
                </Frame>

            </Grid>

            <!-- Status -->
            <Label Text="{Binding StatusMessage}"
                   IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmptyConverter}}"
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light=#555, Dark=#AAA}"
                   FontSize="13"/>

            <Label IsVisible="{Binding LastSync, Converter={StaticResource NotNullConverter}}"
                   FontSize="12" HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light=#888, Dark=#666}">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Последняя синхронизация: "/>
                        <Span Text="{Binding LastSync, StringFormat='{0:dd.MM HH:mm}'}"/>
                    </FormattedString>
                </Label.FormattedText>
            </Label>

            <!-- Actions -->
            <Button Text="🔄 Обновить данные"
                    Command="{Binding RefreshCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light=#512BD4, Dark=#AC99EA}"
                    BorderColor="{AppThemeBinding Light=#512BD4, Dark=#AC99EA}"
                    BorderWidth="1"/>

            <Button Text="☁️ Синхронизировать с HA"
                    Command="{Binding SyncCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
