<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SmartHome.Maui.ViewModels"
             xmlns:models="clr-namespace:SmartHome.Maui.Models"
             x:Class="SmartHome.Maui.Pages.MediaPage"
             x:DataType="vm:MediaViewModel"
             Title="🎵 Медиа">

    <Grid RowDefinitions="*,Auto">

        <RefreshView Grid.Row="0"
                     Command="{Binding RefreshCommand}"
                     IsRefreshing="{Binding IsRefreshing}">
            <CollectionView ItemsSource="{Binding Players}"
                            EmptyView="Нет доступных медиаплееров">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:MediaPlayerState">
                        <Frame Margin="8,4" Padding="12" CornerRadius="10">
                            <VerticalStackLayout Spacing="8">

                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Grid.Column="0">
                                        <Label Text="{Binding DisplayName}" FontSize="16" FontAttributes="Bold"/>
                                        <Label Text="{Binding AreaName}" FontSize="12" TextColor="Gray"/>
                                        <Label Text="{Binding State}" FontSize="12" TextColor="Gray"/>
                                        <Label Text="{Binding VolumePercent, StringFormat='Громкость: {0}%'}"
                                               FontSize="12" TextColor="Gray"
                                               IsVisible="{Binding IsActive}"/>
                                    </VerticalStackLayout>
                                    <Button Grid.Column="1"
                                            Clicked="OnToggleClicked"
                                            CommandParameter="{Binding}"
                                            BackgroundColor="{Binding IsActive, Converter={x:StaticResource BoolToColorConverter}}"
                                            TextColor="White"
                                            CornerRadius="8"
                                            Padding="12,6">
                                        <Button.Text>
                                            <Binding Path="IsActive" Converter="{x:StaticResource BoolToOnOffConverter}"/>
                                        </Button.Text>
                                    </Button>
                                </Grid>

                                <VerticalStackLayout IsVisible="{Binding IsActive}" Spacing="4">

                                    <!-- Play/Pause/Mute row -->
                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                                        <Button Grid.Column="0" Text="▶ Играть" Clicked="OnPlayClicked"
                                                CommandParameter="{Binding EntityId}"
                                                FontSize="12" Padding="4,4" CornerRadius="6"
                                                IsVisible="{Binding IsPlaying, Converter={x:StaticResource InvertBoolConverter}}"/>
                                        <Button Grid.Column="0" Text="⏸ Пауза" Clicked="OnPauseClicked"
                                                CommandParameter="{Binding EntityId}"
                                                FontSize="12" Padding="4,4" CornerRadius="6"
                                                IsVisible="{Binding IsPlaying}"/>
                                        <Button Grid.Column="1" Text="{Binding IsMuted, Converter={x:StaticResource MuteTextConverter}}"
                                                Clicked="OnMuteClicked"
                                                CommandParameter="{Binding}"
                                                FontSize="12" Padding="4,4" CornerRadius="6"/>
                                    </Grid>

                                    <!-- Volume -->
                                    <Label Text="Громкость:" FontSize="12" TextColor="Gray"/>
                                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="4">
                                        <Button Grid.Column="0" Text="10%" Clicked="OnVolume10Clicked" CommandParameter="{Binding EntityId}"
                                                FontSize="12" Padding="4,4" CornerRadius="6"/>
                                        <Button Grid.Column="1" Text="30%" Clicked="OnVolume30Clicked" CommandParameter="{Binding EntityId}"
                                                FontSize="12" Padding="4,4" CornerRadius="6"/>
                                        <Button Grid.Column="2" Text="60%" Clicked="OnVolume60Clicked" CommandParameter="{Binding EntityId}"
                                                FontSize="12" Padding="4,4" CornerRadius="6"/>
                                        <Button Grid.Column="3" Text="90%" Clicked="OnVolume90Clicked" CommandParameter="{Binding EntityId}"
                                                FontSize="12" Padding="4,4" CornerRadius="6"/>
                                    </Grid>

                                </VerticalStackLayout>

                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <Label Grid.Row="1"
               Text="{Binding StatusMessage}"
               TextColor="Red"
               Margin="8,4"
               IsVisible="{Binding StatusMessage, Converter={x:StaticResource StringNotEmptyConverter}}"/>

    </Grid>

</ContentPage>
