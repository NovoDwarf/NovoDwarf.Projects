<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:SmartHome.Maui.Converters"
             x:Class="SmartHome.Maui.App">

    <Application.Resources>
        <ResourceDictionary>
            <conv:BoolToColorConverter     x:Key="BoolToColorConverter"/>
            <conv:BoolToOnOffConverter     x:Key="BoolToOnOffConverter"/>
            <conv:StringNotEmptyConverter  x:Key="StringNotEmptyConverter"/>
            <conv:NotNullConverter         x:Key="NotNullConverter"/>
            <conv:InvertBoolConverter      x:Key="InvertBoolConverter"/>
            <conv:MuteTextConverter        x:Key="MuteTextConverter"/>
            <conv:KettleToggleConverter    x:Key="KettleToggleConverter"/>
        </ResourceDictionary>
    </Application.Resources>

</Application>
