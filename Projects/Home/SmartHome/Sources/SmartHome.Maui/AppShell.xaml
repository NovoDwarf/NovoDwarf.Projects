<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:SmartHome.Maui.Pages"
       x:Class="SmartHome.Maui.AppShell"
       FlyoutBehavior="Flyout">

    <FlyoutItem Title="Главная" Icon="home.png" Route="home">
        <ShellContent ContentTemplate="{DataTemplate pages:HomePage}"/>
    </FlyoutItem>

    <FlyoutItem Title="Свет" Icon="light.png" Route="lights">
        <ShellContent ContentTemplate="{DataTemplate pages:LightsPage}"/>
    </FlyoutItem>

    <FlyoutItem Title="Климат" Route="humidifiers">
        <ShellContent ContentTemplate="{DataTemplate pages:HumidifiersPage}"/>
    </FlyoutItem>

    <FlyoutItem Title="Чайники" Route="kettles">
        <ShellContent ContentTemplate="{DataTemplate pages:KettlesPage}"/>
    </FlyoutItem>

    <FlyoutItem Title="Медиа" Route="media">
        <ShellContent ContentTemplate="{DataTemplate pages:MediaPage}"/>
    </FlyoutItem>

    <FlyoutItem Title="Сценарии" Route="scenes">
        <ShellContent ContentTemplate="{DataTemplate pages:ScenesPage}"/>
    </FlyoutItem>

    <FlyoutItem Title="Сенсоры" Route="sensors">
        <ShellContent ContentTemplate="{DataTemplate pages:SensorsPage}"/>
    </FlyoutItem>

    <FlyoutItem Title="Здоровье" Route="health">
        <ShellContent ContentTemplate="{DataTemplate pages:DashboardPage}"/>
    </FlyoutItem>

    <FlyoutItem Title="Настройки" Route="settings">
        <ShellContent ContentTemplate="{DataTemplate pages:SettingsPage}"/>
    </FlyoutItem>

</Shell>
